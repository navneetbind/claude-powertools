-size:11.5px;margin:2px 4px 2px 0;cursor:pointer}\n.chip:hover{border-color:var(--acc);color:var(--acc)}\n.chip.dead{opacity:.5;cursor:default;text-decoration:line-through}\n.tabs{display:flex;gap:4px;margin-bottom:12px}\n.tab{padding:5px 12px;border-radius:8px;border:1px solid transparent;cursor:pointer;font-size:13px;color:var(--dim)}\n.tab.on{background:var(--card);border-color:var(--line);color:var(--fg);font-weight:600}\n.tab:hover{color:var(--fg)}\ntable.conn{width:100%;border-collapse:collapse}\ntable.conn th{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--dim);\n  text-align:left;padding:6px 10px;border-bottom:1px solid var(--line);font-weight:600}\ntable.conn td{padding:11px 10px;border-bottom:1px solid var(--line);vertical-align:middle}\ntable.conn td:first-child{width:52%}\ntable.conn tr:last-child td{border-bottom:0}\ntable.conn tr:hover td{background:var(--card)}\n.avatar{width:26px;height:26px;flex:0 0 auto;margin-top:1px;border-radius:7px;background:var(--sel);border:1px solid var(--line);\n  display:inline-flex;align-items:center;justify-content:center;font-weight:700;font-size:12px;color:var(--acc)}\n.cname{display:flex;gap:9px;align-items:flex-start}\n.cname>span{min-width:0}\n.cname b{font-size:13.5px;font-weight:650}\n.cwhere{font-size:11px;color:var(--dim);font-family:ui-monospace,Menlo,monospace}\n.ok{color:var(--ok);font-weight:700}\n.off{color:var(--warn)}\n.rowacts{display:flex;gap:6px;align-items:center;justify-content:flex-end;white-space:nowrap}\n.rowacts .ico{width:26px;height:26px;flex:0 0 auto;padding:0}\n.ico svg{width:15px;height:15px;flex:0 0 auto;display:block}\n.rowacts button{height:26px;padding:0 10px;line-height:1;display:inline-flex;align-items:center}\n.keyrow{display:flex;gap:6px;align-items:center;margin-top:4px;font-size:11.5px;color:var(--dim);flex-wrap:wrap}\n.keyval{font-family:ui-monospace,Menlo,monospace;font-size:11px;word-break:break-all;\n  background:var(--code-bg);border:1px solid var(--line);border-radius:4px;padding:1px 5px;max-width:100%}\n.snip{color:var(--dim);font-size:12px;line-height:1.5;margin-top:3px;\n  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}\n.snip b{color:var(--acc);font-weight:700}\n.hint{padding:9px 12px;border:1px solid var(--acc);background:var(--sel);border-radius:8px;\n  font-size:12.5px;margin:8px 10px}\n.bar{height:8px;border-radius:4px;background:var(--acc);min-width:2px}\n.barrow{display:grid;grid-template-columns:86px 1fr 70px;gap:10px;align-items:center;font-size:12px;padding:3px 0}\n.num{text-align:right;font-variant-numeric:tabular-nums}\n.empty{padding:40px;text-align:center;color:var(--dim)}\n.plan{border:1px solid var(--line);border-radius:8px;max-height:230px;overflow:auto;margin:10px 0}\n.plan div{padding:6px 10px;border-bottom:1px solid var(--line);font-size:13px;display:flex;gap:8px}\n.plan div:last-child{border-bottom:0}\n.badge{font-size:10px;text-transform:uppercase;letter-spacing:.05em;padding:1px 5px;border-radius:4px;border:1px solid var(--warn);color:var(--warn);flex:0 0 auto}\n.arrow{display:flex;gap:8px;align-items:center;font-size:13px;flex-wrap:wrap}\n.pill{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:3px 10px;font-size:12px}\n.foot{padding:12px 14px;border-top:1px solid var(--line);display:flex;gap:10px;align-items:center;justify-content:flex-end;flex-wrap:wrap}\n.foot .grow{flex:1;color:var(--dim);font-size:12px}\n.radios{display:flex;gap:8px}\n.radio{border:1px solid var(--line);border-radius:8px;padding:8px 11px;cursor:pointer;font-size:13px}\n.radio.on{border-color:var(--acc);background:var(--sel);font-weight:600}\n.radio small{display:block;color:var(--dim);font-weight:400;font-size:11px}\n#toast{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);background:var(--card);border:1px solid var(--acc);border-radius:9px;padding:11px 16px;display:none;z-index:60;box-shadow:0 8px 26px rgba(0,0,0,.28);align-items:center;gap:12px;font-size:13px}\n#toast.on{display:flex}\n</style></head><body>\n<div id="wrap">\n<aside><h1>Claude PowerTools</h1><div class="sub" id="tot">loading…</div><div id="tree"></div><div style="margin-top:16px;border-top:1px solid var(--line);padding-top:12px"><button id="usebtn" style="width:100%;margin-bottom:6px">Usage…</button><button id="membtn" style="width:100%;margin-bottom:6px">What Claude remembers…</button><button id="mcpbtn" style="width:100%;margin-bottom:6px">MCP connections…</button><button id="bkbtn" style="width:100%;margin-bottom:6px">Backup &amp; move Mac…</button><button id="setbtn" style="width:100%;margin-bottom:6px">Claude settings…</button><button id="instbtn" style="width:100%">Instances…</button></div></aside>\n<main>\n<header>\n  <input type="search" id="q" placeholder="Search titles…  (/ to focus)">\n  <label class="ck"><input type="checkbox" id="fts"> message text</label>\n  <label class="ck"><input type="checkbox" id="arc"> archived</label>\n  <button id="reindex">Reindex</button>\n  <button id="undo">Undo last move</button>\n</header>\n<div id="list"><div class="empty">loading…</div></div>\n<div id="bar">\n  <span id="selinfo"></span>\n  <span id="selall"></span>\n  <span style="flex:1"></span>\n  <select id="dest"></select>\n  <button id="exportsel">Export as MD</button><button class="p" id="transfer">Transfer…</button>\n  <button id="clr">Clear</button>\n</div>\n</main></div>\n\n<div class="ov" id="ovread"><div class="dlg" id="reader">\n  <div class="dhead">\n    <div class="grow"><div class="dtitle" id="rtitle"></div><div class="dmeta" id="rmeta"></div></div>\n    <input type="search" id="rq" placeholder="Find in this chat…" style="width:150px">\n    <span class="find"><span class="dmeta" id="rcount" style="margin:0"></span>\n      <button id="rprev" title="Jump to the previous place this chat mentions your search">↑ Prev</button>\n      <button id="rnext" title="Jump to the next place this chat mentions your search">↓ Next</button></span>\n    <label class="ck"><input type="checkbox" id="rnoise" checked> hide tool noise</label>\n    <button id="rresume" title="Copies a command you paste into Terminal to continue this chat in Claude Code">Resume in Terminal</button><button id="rexport" title="Download this chat as a Markdown file">Export as MD</button><button id="rcopy">Copy</button><button id="rclose">Close</button>\n  </div>\n  <div class="dbody" id="rbody"></div>\n</div></div>\n\n<div class="ov" id="ovmove"><div class="dlg" id="movebox">\n  <div class="dhead"><div class="grow"><div class="dtitle">Transfer chats</div><div class="dmeta" id="mroute"></div></div></div>\n  <div class="dbody">\n    <div class="radios" style="margin-bottom:12px">\n      <div class="radio on" data-mode="copy"><strong>Copy</strong><small>keep in both accounts</small></div>\n      <div class="radio" data-mode="move"><strong>Move</strong><small>remove from source</small></div>\n    </div>\n    <div id="mplan"></div>\n  </div>\n  <div class="foot"><span class="grow" id="mnote"></span>\n    <button id="mcancel">Cancel</button><button class="p" id="mgo">Transfer</button></div>\n</div></div>\n\n<div class="ov" id="ovinfo"><div class="dlg" style="width:min(560px,100%)">\n  <div class="dhead"><div class="grow"><div class="dtitle" id="fititle"></div>\n    <div class="dmeta">where these chats live on this Mac</div></div>\n    <button id="ficlose">Close</button></div>\n  <div class="dbody" style="background:var(--bg)"><div id="fibody"></div></div></div></div>\n\n<div class="ov" id="ovmem"><div class="dlg" style="width:min(860px,100%);height:88vh">\n  <div class="dhead">\n    <div class="grow"><div class="dtitle" id="mtitle">What Claude remembers</div>\n      <div class="dmeta" id="msub">notes Claude wrote for itself while working with you</div></div>\n    <input type="search" id="mq" placeholder="Search memories…" style="width:190px">\n    <button id="mback" hidden>Back</button><button id="mclose">Close</button>\n  </div>\n  <div class="dbody" id="mbody" style="background:var(--bg)"></div></div></div>\n\n<div class="ov" id="ovmcp"><div class="dlg" style="width:min(940px,100%);height:86vh">\n  <div class="dhead"><div class="grow"><div class="dtitle">MCP connections</div>\n    <div class="dmeta" id="mcpsub">which servers each Claude can reach</div></div>\n    <input type="search" id="mcpq" placeholder="Search…" style="width:170px">\n    <button id="mcpclose">Close</button></div>\n  <div class="dbody" id="mcpbody" style="background:var(--bg)"></div></div></div>\n\n<div class="ov" id="ovcopy"><div class="dlg" style="width:min(700px,100%)">\n  <div class="dhead"><div class="grow"><div class="dtitle" id="cpTitle">Copy connector</div>\n    <div class="dmeta" id="cpFrom"></div></div><button id="cpClose">Close</button></div>\n  <div class="dbody" style="background:var(--bg)">\n    <div class="tabs">\n      <div class="tab on" data-c="here">To another Claude on this Mac</div>\n      <div class="tab" data-c="away">To another laptop</div>\n    </div>\n    <div id="cpHere">\n      <div style="display:flex;gap:9px;align-items:center;flex-wrap:wrap;margin-bottom:10px">\n        <label class="ck" style="color:var(--fg)">Copy into</label>\n        <select id="cpDest" style="flex:1;min-width:200px"></select>\n      </div>\n      <div id="cpPlan"></div>\n    </div>\n    <div id="cpAway" hidden></div>\n  </div>\n  <div class="foot"><span class="grow" id="cpNote"></span>\n    <button id="cpCancel">Cancel</button><button class="p" id="cpGo">Copy</button></div>\n</div></div>\n\n<div class="ov" id="ovbk"><div class="dlg" style="width:min(760px,100%);height:86vh">\n  <div class="dhead"><div class="grow"><div class="dtitle">Backup &amp; move to another Mac</div>\n    <div class="dmeta" id="bkSub"></div></div><button id="bkClose">Close</button></div>\n  <div class="dbody" style="background:var(--bg)">\n    <div class="tabs">\n      <div class="tab on" data-b="make">Make a backup</div>\n      <div class="tab" data-b="use">Restore one</div>\n    </div>\n    <div id="bkMake"></div>\n    <div id="bkUse" hidden></div>\n  </div></div></div>\n\n<div class="ov" id="ovset"><div class="dlg" style="width:min(760px,100%);height:86vh">\n  <div class="dhead"><div class="grow"><div class="dtitle">Claude Code settings</div>\n    <div class="dmeta" id="setFile"></div></div><button id="setClose">Close</button></div>\n  <div class="dbody" id="setBody" style="background:var(--bg)"></div></div></div>\n\n<div class="ov" id="ovuse"><div class="dlg" style="width:min(900px,100%);height:88vh">\n  <div class="dhead"><div class="grow"><div class="dtitle">Usage on this Mac</div>\n    <div class="dmeta" id="useSub"></div></div>\n    <select id="useView"><option value="days">by period</option><option value="windows">limit windows</option>\n      <option value="weeks">week by week</option><option value="compare">compare Macs</option></select>\n    <select id="useDays"><option value="7">last 7 days</option><option value="30" selected>last 30 days</option>\n      <option value="90">last 90 days</option><option value="365">last year</option></select>\n    <button id="useCsv">Export CSV</button><button id="useClose">Close</button></div>\n  <div class="dbody" id="useBody" style="background:var(--bg)"></div></div></div>\n\n<div class="ov" id="ovinst"><div class="dlg" style="width:min(760px,100%)">\n  <div class="dhead"><div class="grow"><div class="dtitle">Claude instances</div>\n    <div class="dmeta">each app has its own data folder, its own login and its own chats</div></div>\n    <button id="iclose">Close</button></div>\n  <div class="dbody" style="background:var(--bg)">\n    <div id="ilist"></div>\n    <div style="border-top:1px solid var(--line);margin-top:16px;padding-top:14px">\n      <div style="font-weight:650;margin-bottom:8px">Add another instance</div>\n      <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">\n        <input type="text" id="iname" placeholder="Claude Work 4" style="flex:1;min-width:200px">\n        <button class="p" id="icreate" disabled>Create…</button>\n      </div>\n      <div id="iplan" style="margin-top:10px"></div>\n    </div>\n  </div></div></div>\n\n<div id="toast"><span id="tmsg"></span><button id="tundo">Undo</button><button id="tx">Dismiss</button></div>\n\n<script>\nconst T=new URLSearchParams(location.search).get(\'t\');\nconst api=(p,o={})=>fetch(p+(p.includes(\'?\')?\'&\':\'?\')+\'t=\'+T,o).then(r=>{\n  if(r.status===403){document.body.innerHTML=\'<div style="padding:40px;max-width:520px;font:15px/1.6 system-ui"><h2 style="margin:0 0 8px">This link has expired</h2>\'+\n    \'PowerTools was restarted with a new key. Open it again from <b>Claude PowerTools.app</b> or run <code>powertools</code> in a terminal, and use the link it prints.</div>\';throw new Error(\'stale token\')}\n  return r.json()});\nconst $=id=>document.getElementById(id);\nconst esc=s=>(s??\'\').replace(/[&<>"]/g,c=>({\'&\':\'&amp;\',\'<\':\'&lt;\',\'>\':\'&gt;\',\'"\':\'&quot;\'}[c]));\nconst when=ms=>ms?new Date(ms).toISOString().slice(0,10):\'—\';\nconst short=u=>u?u.slice(0,8):\'\';\nlet scope=null,rows=[],sel=new Set(),tree=[],matched=0,lastAnchor=null;\nlet cur=null,msgs=[],chatFiles=[],shown=0,mode=\'copy\',lastMove=null,vis=[],matches=[],curMatch=-1;\n\n/* ---------- sidebar ---------- */\nfunction bucketName(b){return b.label||(\'account \'+short(b.account))}\nfunction drawTree(){\n  const el=$(\'tree\');let h=\'\',inst=null,tot=0;\n  for(const b of tree){\n    tot+=b.count;\n    if(b.instance!==inst){inst=b.instance;h+=`<div class="inst">${esc(inst)}</div>`}\n    h+=`<div class="b${scope===b.key?\' on\':\'\'}" data-k="${esc(b.key)}" data-a="${esc(b.account)}">\n      <div class="t"><span class="nm">${esc(bucketName(b))}</span>\n        <span class="acts">\n          <button class="ico" data-act="info" title="Details and copy">i</button>\n          <button class="ico" data-act="rename" title="Rename">✎</button>\n        </span><span class="cnt">${b.count}</span></div>\n      <div class="s">${short(b.account)} · org ${short(b.org)}</div></div>`;\n  }\n  el.innerHTML=`<div class="b${scope?\'\':\' on\'}" data-k=""><div class="t"><span class="nm">All chats</span><span class="cnt">${tot}</span></div></div>`+h;\n  el.querySelectorAll(\'.b\').forEach(n=>{\n    n.onclick=e=>{\n      const act=e.target.dataset&&e.target.dataset.act;\n      if(act){\n        e.stopPropagation();\n        const b=tree.find(x=>x.key===n.dataset.k);\n        if(act===\'rename\'){\n          const v=prompt(\'Name this account\',b.label||\'\');\n          if(v!==null)api(\'/api/label\',{method:\'POST\',headers:{\'content-type\':\'application/json\'},\n            body:JSON.stringify({uuid:b.account,label:v})}).then(boot);\n        } else showInfo(b);\n        return;\n      }\n      scope=n.dataset.k||null;sel.clear();drawTree();load();\n    };\n  });\n  $(\'dest\').innerHTML=tree.map(b=>`<option value="${esc(b.key)}">→ ${esc(bucketName(b))} · ${esc(b.instance)}</option>`).join(\'\');\n}\n\n/* ---------- table ---------- */\nfunction drawRows(){\n  const el=$(\'list\');\n  if(!rows.length){el.innerHTML=\'<div class="empty">No chats match.</div>\';return}\n  const allOn=rows.length&&rows.every(r=>sel.has(r.reg_path));\n  el.innerHTML=`<table><thead><tr>\n    <th class="cbx"><input type="checkbox" id="all" ${allOn?\'checked\':\'\'}></th>\n    <th>Title</th><th>Account</th><th>Project</th><th>Date</th><th class="n">Msgs</th><th title="Models this chat actually ran on, by output. The app\'s own setting is shown faded when nothing has run yet.">Ran on</th></tr></thead><tbody>`+\n  rows.map((r,i)=>`<tr class="${sel.has(r.reg_path)?\'sel\':\'\'}" data-i="${i}">\n    <td class="cbx"><input type="checkbox" ${sel.has(r.reg_path)?\'checked\':\'\'}></td>\n    <td class="ttl">${esc(r.title)}\n      ${(r.snippets&&r.snippets.length)?`<div class="snip">${r.snippets.map(x=>\n        esc(x).replace(/&lt;&lt;/g,\'<b>\').replace(/&gt;&gt;/g,\'</b>\')).join(\' \')}</div>`:\'\'}</td>\n    <td class="meta">${esc(r.label||short(r.account))}</td>\n    <td class="meta">${esc((r.cwd||\'\').split(\'/\').slice(-1)[0])}</td>\n    <td class="meta">${when(r.activity)}</td>\n    <td class="n">${r.msgs||0}</td>\n    <td class="meta">${(r.used&&r.used.length)\n        ? r.used.slice(0,2).map(u=>`<span title="${esc(shortModel(u.model))}: ${kfmt(u.output)} out, ${u.requests} replies">${esc(shortModel(u.model))}</span>`).join(\' · \')+(r.used.length>2?` +${r.used.length-2}`:\'\')\n        : `<span style="opacity:.45" title="set in the app, nothing has run yet">${esc((r.model||\'\').replace(\'claude-\',\'\'))}</span>`}</td></tr>`).join(\'\')+\'</tbody></table>\';\n  $(\'all\').onclick=e=>{\n    if(e.target.checked)rows.forEach(r=>sel.add(r.reg_path));\n    else rows.forEach(r=>sel.delete(r.reg_path));\n    drawRows();drawBar();\n  };\n  el.querySelectorAll(\'tbody tr\').forEach(tr=>{\n    const i=+tr.dataset.i,r=rows[i];\n    tr.querySelector(\'input\').onclick=e=>{\n      e.stopPropagation();\n      if(e.shiftKey&&lastAnchor!==null){\n        const [a,b]=[Math.min(lastAnchor,i),Math.max(lastAnchor,i)];\n        const on=!sel.has(r.reg_path);\n        for(let k=a;k<=b;k++)on?sel.add(rows[k].reg_path):sel.delete(rows[k].reg_path);\n      } else {\n        sel.has(r.reg_path)?sel.delete(r.reg_path):sel.add(r.reg_path);\n      }\n      lastAnchor=i;drawRows();drawBar();\n    };\n    tr.querySelector(\'.ttl\').onclick=()=>openChat(r);\n  });\n}\n\nfunction drawBar(){\n  $(\'bar\').classList.toggle(\'on\',sel.size>0);\n  $(\'selinfo\').textContent=sel.size+\' selected\';\n  const more=matched>rows.length;\n  $(\'selall\').innerHTML = more&&sel.size<matched\n    ? `<span class="link" id="sa">select all ${matched} matching</span>` : \'\';\n  if($(\'sa\'))$(\'sa\').onclick=async()=>{\n    const d=await api(qstr(\'&idsonly=1\'));\n    d.ids.forEach(x=>sel.add(x));drawRows();drawBar();\n  };\n}\n\nfunction qstr(extra=\'\'){\n  const q=$(\'q\').value.trim();\n  return `/api/sessions?scope=${encodeURIComponent(scope||\'\')}&q=${encodeURIComponent(q)}`+\n    `&fts=${$(\'fts\').checked?1:0}&archived=${$(\'arc\').checked?1:0}`+extra;\n}\n\nasync function load(){\n  const d=await api(qstr());\n  rows=d.rows;matched=d.matched;\n  window._bodyQuery=($(\'fts\').checked&&$(\'q\').value.trim())?$(\'q\').value.trim():\'\';\n  window._ftsCount=d.fts_indexed;\n  $(\'tot\').textContent=`${d.total} chats indexed`;\n  drawRows();drawBar();\n  if($(\'fts\').checked&&!d.fts_indexed){\n    $(\'list\').insertAdjacentHTML(\'afterbegin\',\n      `<div class="hint">Message text is not indexed yet. Press <strong>Reindex</strong> once\n       (about 8 seconds) and searches will look inside every conversation.</div>`);\n  }\n}\nasync function boot(){const d=await api(\'/api/tree\');tree=d.buckets;drawTree();await load()}\n\n/* ---------- chat reader ---------- */\nconst NOISE=new Set([\'tool\',\'result\',\'thinking\']);\n\n/* markdown -> html, always on ALREADY-ESCAPED text */\nfunction md(t){\n  const code=[];\n  t=t.replace(/```(\\w*)\\n?([\\s\\S]*?)```/g,(m,l,c)=>{code.push(c.replace(/\\n$/,\'\'));return `\\u0000${code.length-1}\\u0000`});\n  t=t.replace(/^######\\s+(.*)$/gm,\'<h3>$1</h3>\').replace(/^#####\\s+(.*)$/gm,\'<h3>$1</h3>\')\n     .replace(/^####\\s+(.*)$/gm,\'<h3>$1</h3>\').replace(/^###\\s+(.*)$/gm,\'<h3>$1</h3>\')\n     .replace(/^##\\s+(.*)$/gm,\'<h2>$1</h2>\').replace(/^#\\s+(.*)$/gm,\'<h1>$1</h1>\');\n  t=t.replace(/^\\s*([-*_])\\1{2,}\\s*$/gm,\'<hr>\');\n  t=t.replace(/`([^`\\n]+)`/g,\'<code>$1</code>\');\n  t=t.replace(/\\*\\*([^*\\n][^*]*?)\\*\\*/g,\'<strong>$1</strong>\');\n  t=t.replace(/(^|[\\s(])\\*([^*\\n]+?)\\*(?=[\\s).,!?]|$)/g,\'$1<em>$2</em>\');\n  t=t.replace(/\\[([^\\]]+)\\]\\((https?:[^)\\s]+)\\)/g,\'<a href="$2" target="_blank" rel="noreferrer">$1</a>\');\n  t=t.replace(/^&gt;\\s?(.*)$/gm,\'<blockquote>$1</blockquote>\');\n  const out=[];let list=null;\n  const closeList=()=>{if(list){out.push(`</${list}>`);list=null}};\n  const cells=r=>r.replace(/^\\s*\\|/,\'\').replace(/\\|\\s*$/,\'\').split(\'|\').map(c=>c.trim());\n  const SEP=/^\\s*\\|?\\s*:?-{2,}:?\\s*(\\|\\s*:?-{2,}:?\\s*)*\\|?\\s*$/;\n  const lines=t.split(\'\\n\');\n  for(let i=0;i<lines.length;i++){\n    const raw=lines[i];\n    /* GitHub-style table: a header row, a dashed separator, then rows */\n    if(raw.includes(\'|\') && i+1<lines.length && SEP.test(lines[i+1])\n       && cells(lines[i+1]).length===cells(raw).length && cells(raw).length>1){\n      closeList();\n      const head=cells(raw);\n      const align=cells(lines[i+1]).map(c=>\n        c.startsWith(\':\')&&c.endsWith(\':\')?\'center\':c.endsWith(\':\')?\'right\':\'left\');\n      const body=[];\n      i+=2;\n      while(i<lines.length && lines[i].includes(\'|\') && lines[i].trim()){\n        body.push(cells(lines[i])); i++;\n      }\n      i--;\n      /* a key-value table often has an empty header row - don\'t draw an empty bar */\n      const blankHead=head.every(h=>!h.replace(/<[^>]*>/g,\'\').trim());\n      out.push(`<div class="tw"><table>`+\n        (blankHead?\'\':`<thead><tr>`+\n          head.map((h,k)=>`<th style="text-align:${align[k]||\'left\'}">${h}</th>`).join(\'\')+\n          `</tr></thead>`)+\n        `<tbody>`+\n        body.map(r=>`<tr>`+head.map((_,k)=>\n          `<td style="text-align:${align[k]||\'left\'}">${r[k]===undefined?\'\':r[k]}</td>`).join(\'\')+\n          `</tr>`).join(\'\')+\n        `</tbody></table></div>`);\n      continue;\n    }\n    const ul=raw.match(/^\\s*[-*+]\\s+(.*)$/), ol=raw.match(/^\\s*\\d+[.)]\\s+(.*)$/);\n    if(ul||ol){\n      const want=ul?\'ul\':\'ol\';\n      if(list!==want){if(list)out.push(`</${list}>`);out.push(`<${want}>`);list=want}\n      out.push(`<li>${(ul||ol)[1]}</li>`);continue;\n    }\n    closeList();\n    out.push(raw);\n  }\n  closeList();\n  t=out.join(\'\\n\');\n  t=t.split(/\\n{2,}/).map(p=>{\n    const x=p.trim();\n    if(!x)return\'\';\n    return /^<(h[1-3]|ul|ol|pre|blockquote|hr|div class="tw")/.test(x)?x:`<p>${x.replace(/\\n/g,\'<br>\')}</p>`;\n  }).join(\'\');\n  return t.replace(/\\u0000(\\d+)\\u0000/g,(m,i)=>`<pre><code>${code[i]}</code></pre>`);\n}\n\n/* a message survives the filters if any visible block matches */\nfunction keptBlocks(m){\n  const hide=$(\'rnoise\').checked;\n  return m.blocks.filter(b=>!(hide&&NOISE.has(b.kind)));\n}\nfunction visible(){\n  return msgs.map(m=>({...m,blocks:keptBlocks(m)})).filter(m=>m.blocks.length);\n}\n/* which messages contain the search term, in order */\nconst terms=()=>$(\'rq\').value.trim().toLowerCase().split(/\\s+/).filter(Boolean);\nfunction findMatches(){\n  const t=terms();\n  if(!t.length)return [];\n  const out=[];\n  vis.forEach((m,i)=>{\n    const text=m.blocks.map(b=>b.text||\'\').join(\'\\n\').toLowerCase();\n    if(t.every(w=>text.includes(w)))out.push(i);\n  });\n  return out;\n}\nfunction hl(t){\n  const ws=terms();\n  if(!ws.length)return t;\n  for(const w of ws){\n    t=t.replace(new RegExp(\'(?![^<]*>)\'+w.replace(/[.*+?^${}()|[\\]\\\\]/g,\'\\\\$&\'),\'gi\'),\n                m=>`<mark>${m}</mark>`);\n  }\n  return t;\n}\nfunction blockHtml(b){\n  if(b.kind===\'text\')  return `<div class="prose">${hl(md(esc(b.text)))}</div>`;\n  if(b.kind===\'image\') return `<img class="shot" alt="screenshot in this chat"\n      title="click to open full size"\n      src="/api/image?id=${encodeURIComponent(cur.cli_id)}&n=${b.idx}&t=${T}">`;\n  if(b.kind===\'thinking\')\n    return `<details class="step"><summary><span class="stepname">thinking</span></summary><pre>${hl(esc(b.text))}</pre></details>`;\n  if(b.kind===\'tool\')\n    return `<details class="step"><summary><span class="stepname">${esc(b.name)}</span></summary><pre>${hl(esc(b.text))}</pre></details>`;\n  return `<details class="step"><summary><span class="stepname">result</span></summary><pre>${hl(esc(b.text))}</pre></details>`;\n}\nfunction renderChunk(reset){\n  const body=$(\'rbody\');\n  if(reset){\n    vis=visible();body.innerHTML=\'\';shown=0;\n    if(chatFiles.length)body.insertAdjacentHTML(\'beforeend\',\n      `<div class="files"><div class="hd">Files this chat pointed at</div>`+\n      chatFiles.map(f=>`<div class="row"><span>${f.kind===\'pdf\'?\'PDF\':\'file\'}</span>\n        <span><code>${esc(f.filename)}</code>\n        ${f.pages?` · ${f.pages} pages`:\'\'}${f.size?` · ${(f.size/1e6).toFixed(1)} MB`:\'\'}\n        ${f.exists?\'\':\'<span class="gone">· no longer on disk</span>\'}</span></div>`).join(\'\')+\n      `<div class="dmeta" style="margin-top:6px">Only the path was saved, not the file itself.</div></div>`);\n  }\n  const v=vis;\n  if(!v.length){$(\'rcount\').textContent=\'0 shown\';body.innerHTML=\'<div class="empty">Nothing to show.</div>\';return}\n  const next=v.slice(shown,shown+40);\n  body.insertAdjacentHTML(\'beforeend\',next.map(m=>{\n    const stamp=`<div class="stamp">${esc((m.ts||\'\').slice(0,16).replace(\'T\',\' \'))}</div>`;\n    const inner=m.blocks.map(blockHtml).join(\'\');\n    return m.role===\'user\'\n      ? `<div class="turn user"><div class="bubble">${stamp}<div class="inner">${inner}</div></div></div>`\n      : `<div class="turn assistant">${stamp}${inner}</div>`;\n  }).join(\'\'));\n  shown+=next.length;\n  clampLongMessages();\n  const q=$(\'rq\').value.trim();\n  $(\'rcount\').textContent=q\n    ? (matches.length?`match ${curMatch+1} of ${matches.length}`:\'no matches in this chat\')\n    : `${v.length} messages`;\n  $(\'rprev\').hidden=$(\'rnext\').hidden=!(q&&matches.length);\n}\n\n/* long messages collapse behind Show more, the way the Claude app does it */\nfunction clampLongMessages(){\n  document.querySelectorAll(\'.turn.user .bubble:not([data-clamped])\').forEach(b=>{\n    b.dataset.clamped=\'1\';\n    const inner=b.querySelector(\'.inner\');\n    if(!inner||inner.scrollHeight<=260)return;\n    b.classList.add(\'clamped\');\n    const btn=document.createElement(\'button\');\n    btn.className=\'showmore\';btn.textContent=\'Show more\';\n    btn.onclick=()=>{\n      const open=b.classList.toggle(\'clamped\');\n      btn.textContent=open?\'Show more\':\'Show less\';\n    };\n    b.appendChild(btn);\n  });\n}\n\n/* load the next chunk as the reader nears the end - no button to press */\nfunction ensureRendered(i){\n  let guard=0;\n  while(shown<=i && shown<vis.length && guard++<400)renderChunk(false);\n}\nfunction gotoMatch(step){\n  if(!matches.length)return;\n  curMatch=(curMatch+step+matches.length)%matches.length;\n  const target=matches[curMatch];\n  ensureRendered(target);\n  const turns=$(\'rbody\').querySelectorAll(\'.turn\');\n  const el=turns[target];\n  if(el){\n    turns.forEach(t=>t.classList.remove(\'curmatch\'));\n    el.classList.add(\'curmatch\');\n    el.scrollIntoView({block:\'center\'});\n  }\n  $(\'rcount\').textContent=`match ${curMatch+1} of ${matches.length}`;\n  $(\'rprev\').hidden=$(\'rnext\').hidden=false;\n}\nfunction runFind(){\n  renderChunk(true);\n  matches=findMatches();curMatch=-1;\n  if(matches.length)gotoMatch(1);\n  else{$(\'rcount\').textContent=$(\'rq\').value.trim()?\'no matches in this chat\':`${vis.length} messages`;\n       $(\'rprev\').hidden=$(\'rnext\').hidden=true;}\n}\n\nfunction maybeMore(){\n  const p=$(\'rbody\');\n  if(shown>=vis.length)return;\n  if(p.scrollTop+p.clientHeight >= p.scrollHeight-900){\n    renderChunk(false);\n    if(shown<vis.length&&p.scrollHeight<=p.clientHeight)maybeMore();\n  }\n}\nasync function openChat(r){\n  cur=r;$(\'ovread\').classList.add(\'on\');\n  $(\'rtitle\').textContent=r.title;$(\'rq\').value=\'\';\n  $(\'rmeta\').textContent=\'loading…\';\n  $(\'rbody\').innerHTML=\'<div class="empty">loading transcript…</div>\';\n  const d=await api(\'/api/session?id=\'+encodeURIComponent(r.cli_id));\n  msgs=d.messages;chatFiles=d.files||[];\n  const used=(d.used||[]).map(u=>`${shortModel(u.model)} ${kfmt(u.output)}`).join(\' · \');\n  $(\'rmeta\').textContent=`${msgs.length} messages · ${when(r.activity)} · ${r.cwd||\'\'}`;\n  $(\'rmeta\').title=used?\'output tokens by model: \'+used:\'\';\n  if($(\'rmodels\'))$(\'rmodels\').remove();\n  if(used)$(\'rmeta\').insertAdjacentHTML(\'afterend\',\n    `<div class="dmeta" id="rmodels" style="margin-top:2px">ran on: `+\n    (d.used||[]).map(u=>`<span title="${u.requests} replies · ${kfmt(u.input)} in · ${u.first} to ${u.last}">${esc(shortModel(u.model))} <b>${kfmt(u.output)}</b></span>`).join(\' · \')+`</div>`);\n  if(!msgs.length){$(\'rbody\').innerHTML=\'<div class="empty">No transcript file on disk for this chat.</div>\';return}\n  matches=[];curMatch=-1;\n  $(\'rq\').value=window._bodyQuery||\'\';\n  renderChunk(true);\n  $(\'rbody\').onscroll=maybeMore;\n  if($(\'rq\').value.trim())runFind(); else maybeMore();\n}\n\n/* ---------- transfer ---------- */\nfunction destBucket(){return tree.find(b=>b.key===$(\'dest\').value)}\nasync function openMove(){\n  const d=destBucket();\n  $(\'mroute\').textContent=`${sel.size} chat(s)  →  ${bucketName(d)} · ${d.instance}`;\n  $(\'ovmove\').classList.add(\'on\');\n  $(\'mplan\').innerHTML=\'<div class="empty">checking…</div>\';\n  const p=await api(\'/api/move\',{method:\'POST\',headers:{\'content-type\':\'application/json\'},\n    body:JSON.stringify({ids:[...sel],dest:$(\'dest\').value,mode,dry:true})});\n  const ow=p.steps.filter(s=>s.overwrite).length;\n  $(\'mplan\').innerHTML=(p.steps.length?\n    `<div class="plan">`+p.steps.map(s=>`<div>${s.overwrite?\'<span class="badge">overwrites</span>\':\'\'}<span>${esc(s.title)}</span></div>`).join(\'\')+`</div>`\n    :\'<div class="warn">Nothing to transfer.</div>\')+\n    (p.skipped.length?`<div class="dmeta">${p.skipped.length} skipped (already there or missing)</div>`:\'\');\n  $(\'mnote\').innerHTML=(ow?`<strong>${ow} will overwrite a chat already there.</strong> `:\'\')+\n    (mode===\'move\'?\'Originals leave the source account. \':\'\')+\n    \'A copy of both sides is saved first. To reverse it, press <strong>Undo last move</strong> \'+\n    \'at the top of the window (or run <code>powertools undo</code>). Only the most recent transfer \'+\n    \'can be reversed this way.\';\n  $(\'mgo\').disabled=!p.steps.length;\n  $(\'mgo\').textContent=mode===\'move\'?`Move ${p.steps.length}`:`Copy ${p.steps.length}`;\n}\nasync function runMove(){\n  $(\'mgo\').disabled=true;$(\'mgo\').textContent=\'Working…\';\n  const r=await api(\'/api/move\',{method:\'POST\',headers:{\'content-type\':\'application/json\'},\n    body:JSON.stringify({ids:[...sel],dest:$(\'dest\').value,mode,dry:false})});\n  lastMove=r;$(\'ovmove\').classList.remove(\'on\');sel.clear();\n  toast(`${r.moved} chat(s) transferred. Quit Claude (Cmd+Q) and reopen to see them. Backup: ${r.backup}`);\n  boot();\n}\nfunction toast(m){$(\'tmsg\').textContent=m;$(\'toast\').classList.add(\'on\')}\n\n/* ---------- wiring ---------- */\n$(\'q\').oninput=()=>{clearTimeout(window._t);window._t=setTimeout(load,220)};\n$(\'fts\').onchange=load;$(\'arc\').onchange=load;\n$(\'clr\').onclick=()=>{sel.clear();drawRows();drawBar()};\n$(\'transfer\').onclick=openMove;\n$(\'mcancel\').onclick=()=>$(\'ovmove\').classList.remove(\'on\');\n$(\'mgo\').onclick=runMove;\ndocument.querySelectorAll(\'.radio\').forEach(n=>n.onclick=()=>{\n  document.querySelectorAll(\'.radio\').forEach(x=>x.classList.remove(\'on\'));\n  n.classList.add(\'on\');mode=n.dataset.mode;openMove();\n});\n$(\'rclose\').onclick=()=>$(\'ovread\').classList.remove(\'on\');\n$(\'rbody\').addEventListener(\'click\',e=>{\n  if(e.target.classList.contains(\'shot\'))window.open(e.target.src,\'_blank\');\n});\n$(\'rq\').oninput=()=>{clearTimeout(window._f);window._f=setTimeout(runFind,250)};\n$(\'rnoise\').onchange=runFind;\n$(\'rnext\').onclick=()=>gotoMatch(1);\n$(\'rprev\').onclick=()=>gotoMatch(-1);\n$(\'rq\').onkeydown=e=>{if(e.key===\'Enter\'){e.preventDefault();gotoMatch(e.shiftKey?-1:1)}};\n$(\'rcopy\').onclick=()=>{\n  navigator.clipboard.writeText(visible().map(m=>`### ${m.role}\\n`+m.blocks.map(b=>b.kind===\'text\'?b.text:`[${b.name||b.kind}]\\n${b.text}`).join(\'\\n\')).join(\'\\n\\n\'));\n  $(\'rcopy\').textContent=\'Copied\';setTimeout(()=>$(\'rcopy\').textContent=\'Copy\',1200);\n};\n$(\'tx\').onclick=()=>$(\'toast\').classList.remove(\'on\');\n$(\'tundo\').onclick=async()=>{const r=await api(\'/api/undo\',{method:\'POST\'});\n  $(\'toast\').classList.remove(\'on\');alert(r.msg);boot()};\n$(\'reindex\').onclick=async e=>{const b=e.target;b.disabled=true;b.textContent=\'Indexing…\';\n  await api(\'/api/reindex?fts=\'+($(\'fts\').checked?1:0),{method:\'POST\'});\n  b.disabled=false;b.textContent=\'Reindex\';boot()};\n$(\'undo\').onclick=async()=>{\n  if(!confirm(\'Reverse the last transfer?\\n\\nChats that were copied get removed again, chats that were moved go back to the account they came from, and anything that was overwritten is restored.\'))return;\n  const r=await api(\'/api/undo\',{method:\'POST\'});\n  alert(r.msg+(r.ok?\'\\n\\nQuit Claude (Cmd+Q) and reopen to see the change.\':\'\'));boot()};\ndocument.querySelectorAll(\'.ov\').forEach(o=>o.onclick=e=>{if(e.target===o)o.classList.remove(\'on\')});\ndocument.onkeydown=e=>{\n  if(e.key===\'Escape\')document.querySelectorAll(\'.ov.on\').forEach(o=>o.classList.remove(\'on\'));\n  if(e.key===\'/\'&&e.target.tagName!==\'INPUT\'){e.preventDefault();$(\'q\').focus()}\n  if((e.metaKey||e.ctrlKey)&&e.key===\'a\'&&e.target.tagName!==\'INPUT\'&&rows.length){\n    e.preventDefault();rows.forEach(r=>sel.add(r.reg_path));drawRows();drawBar();\n  }\n};\n\n/* ---------- what Claude remembers ---------- */\nlet mem={items:[],index:null};\nasync function loadMemory(){\n  $(\'mbody\').innerHTML=\'<div class="empty">reading…</div>\';\n  mem=await api(\'/api/memory\');\n  drawMemory();\n}\nfunction drawMemory(){\n  $(\'mback\').hidden=true;\n  $(\'mtitle\').textContent=\'What Claude remembers\';\n  const q=$(\'mq\').value.trim().toLowerCase();\n  let items=mem.items;\n  if(q)items=items.filter(i=>(i.name+\' \'+i.description+\' \'+i.body).toLowerCase().includes(q));\n  $(\'msub\').textContent=`${items.length} of ${mem.items.length} notes Claude wrote for itself`;\n  const by={};items.forEach(i=>{(by[i.type]=by[i.type]||[]).push(i)});\n  const order=[\'user\',\'feedback\',\'project\',\'reference\',\'note\'];\n  const keys=Object.keys(by).sort((a,b)=>order.indexOf(a)-order.indexOf(b));\n  $(\'mbody\').innerHTML=items.length?keys.map(k=>\n    `<div class="mgroup">${esc(k)} (${by[k].length})</div>`+\n    by[k].map(i=>`<div class="mrow" data-n="${esc(i.name)}">\n      <div class="mn">${esc(i.name)}${i.session?\'<span class="tag">from a chat</span>\':\'\'}</div>\n      <div class="md">${esc(i.description||i.body.slice(0,120))}</div></div>`).join(\'\')\n  ).join(\'\'):\'<div class="empty">Nothing matches.</div>\';\n  $(\'mbody\').querySelectorAll(\'.mrow\').forEach(r=>r.onclick=()=>showMemory(r.dataset.n));\n}\nfunction showMemory(name){\n  const i=mem.items.find(x=>x.name===name);\n  if(!i)return;\n  $(\'mback\').hidden=false;\n  $(\'mtitle\').textContent=i.name;\n  $(\'msub\').textContent=`${i.type} · ${i.project} · ${(i.modified||\'\').slice(0,10)}`;\n  const chat=i.session?rows.find(r=>r.cli_id===i.session):null;\n  $(\'mbody\').innerHTML=\n    (i.description?`<div class="warn">${esc(i.description)}</div>`:\'\')+\n    `<div class="prose">${md(esc(i.body))}</div>`+\n    (i.links.length?`<div style="margin-top:14px"><div class="mgroup">related notes</div>`+\n      i.links.map(l=>i.dangling.includes(l)\n        ? `<span class="chip dead" title="no note by that name yet">${esc(l)}</span>`\n        : `<span class="chip" data-l="${esc(l)}">${esc(l)}</span>`).join(\'\')+`</div>`:\'\')+\n    `<div style="margin-top:16px;display:flex;gap:8px;flex-wrap:wrap">\n       <button id="mcopy">Copy note</button>\n       ${i.session?`<button id="mchat">Open the chat this came from</button>`:\'\'}\n     </div>\n     <div class="dmeta" style="margin-top:10px">file: <code>${esc(i.file)}</code></div>`;\n  $(\'mbody\').querySelectorAll(\'.chip[data-l]\').forEach(c=>c.onclick=()=>showMemory(c.dataset.l));\n  $(\'mcopy\').onclick=()=>{navigator.clipboard.writeText(i.body);\n    $(\'mcopy\').textContent=\'Copied\';setTimeout(()=>$(\'mcopy\').textContent=\'Copy note\',1200)};\n  if($(\'mchat\'))$(\'mchat\').onclick=async()=>{\n    let r=rows.find(x=>x.cli_id===i.session);\n    if(!r){const d=await api(`/api/sessions?q=&limit=100000`);r=d.rows.find(x=>x.cli_id===i.session)}\n    if(!r)return alert(\'That chat is no longer registered with any account.\');\n    $(\'ovmem\').classList.remove(\'on\');openChat(r);\n  };\n}\n$(\'membtn\').onclick=()=>{$(\'ovmem\').classList.add(\'on\');$(\'mq\').value=\'\';loadMemory()};\n$(\'mclose\').onclick=()=>$(\'ovmem\').classList.remove(\'on\');\n$(\'mback\').onclick=drawMemory;\n$(\'mq\').oninput=()=>{clearTimeout(window._m);window._m=setTimeout(drawMemory,220)};\n\n/* ---------- usage ---------- */\nconst kfmt=n=>n>=1e6?(n/1e6).toFixed(1)+\'M\':n>=1e3?Math.round(n/1e3)+\'k\':String(n);\nconst shortModel=m=>(m||\'\').replace(\'claude-\',\'\').replace(/-\\d{8}$/,\'\');\nconst resetPrefs=()=>({wd:localStorage.getItem(\'pt_reset_wd\')||\'3\',at:localStorage.getItem(\'pt_reset_at\')||\'22:30\'});\nconst dayNames=[\'Mon\',\'Tue\',\'Wed\',\'Thu\',\'Fri\',\'Sat\',\'Sun\'];\nfunction colorFor(list){window.color=m=>[\'var(--acc)\',\'#6a8fd8\',\'#7fb069\',\'#c98bd8\',\'#d8b36a\',\'#8ab4b8\',\'#b88a7a\',\'#999\'][list.indexOf(m)%8]}\n\nasync function accountBar(reload){\n  const r=await api(\'/api/resets\');\n  let cur=localStorage.getItem(\'pt_scope\');\n  if(cur===null){const first=r.options.find(o=>o.kind===\'instance\'&&o.account===r.signed_in);cur=first?first.value:\'\'}\n  const opt=r.options.find(o=>o.value===cur);\n  const acctKey=opt?opt.account:\'\';\n  const rs=r.resets[acctKey]||{weekday:3,hhmm:\'22:30\'};\n  return {html:`<div style="display:flex;gap:8px;align-items:center;margin-bottom:12px;flex-wrap:wrap">\n      <span class="cwhere">export for</span>\n      <select id="accSel" style="max-width:360px"><option value="" ${cur?\'\':\'selected\'}>everything on this Mac (not exportable)</option>\n        ${r.options.map(o=>`<option value="${esc(o.value)}" ${o.value===cur?\'selected\':\'\'}>${esc(o.label)}</option>`).join(\'\')}</select>\n      <span class="cwhere">its weekly limit resets</span>\n      <select id="rwd">${dayNames.map((n,i)=>`<option value="${i}" ${i===rs.weekday?\'selected\':\'\'}>${n}</option>`).join(\'\')}</select>\n      <input type="text" id="rat" value="${esc(rs.hhmm)}" style="width:70px"><button id="rsave">Apply</button>\n      <span class="cwhere" title="Each Claude subscription resets at its own moment. Read it off that app\'s limits panel. Apps signed into the same account share one reset.">?</span>\n      <span style="flex:1"></span><span id="accExtra"></span></div>`,\n    scope:cur, account:acctKey, reset:rs, exportable:!!cur,\n    wire:()=>{\n      $(\'accSel\').onchange=()=>{localStorage.setItem(\'pt_scope\',$(\'accSel\').value);reload()};\n      $(\'rsave\').onclick=async()=>{\n        const o=r.options.find(x=>x.value===$(\'accSel\').value);\n        if(!o)return alert(\'Pick an app or account first. The reset belongs to an account.\');\n        await api(\'/api/reset\',{method:\'POST\',headers:{\'content-type\':\'application/json\'},\n          body:JSON.stringify({account:o.account,weekday:+$(\'rwd\').value,hhmm:$(\'rat\').value.trim()})});\n        reload();\n      };\n    }};\n}\nasync function loadWeeks(){\n  $(\'useBody\').innerHTML=\'<div class="empty">bucketing into weeks…</div>\';\n  const bar=await accountBar(loadWeeks);\n  const d=await api(`/api/usage_history?weeks=8&scope=${encodeURIComponent(bar.scope)}`);\n  const allModels=[...new Set(d.weeks.flatMap(w=>Object.keys(w.models)))];colorFor(allModels);\n  const wd=d.reset.weekday, at=d.reset.hhmm;\n  $(\'useSub\').textContent=`${d.scope.label} · weeks cut at the ${dayNames[wd]} ${at} reset · this Mac only`;\n  $(\'useBody\').innerHTML=bar.html+\n    d.weeks.slice().reverse().map(w=>{\n      const models=Object.entries(w.models).sort((a,b)=>b[1].output-a[1].output);\n      const tot=models.reduce((a,[,v])=>a+v.output,0);\n      const fable=models.filter(([m])=>m.includes(\'fable\')).reduce((a,[,v])=>a+v.output,0);\n      const maxDay=Math.max(1,...w.days.map(x=>Object.values(x.models).reduce((a,b)=>a+b,0)));\n      return `<div style="border:1px solid var(--line);border-radius:10px;padding:12px 14px;margin-bottom:12px;background:var(--card)${w.current?\';border-color:var(--acc)\':\'\'}">\n        <div style="display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;align-items:baseline">\n          <strong>Week from ${esc(w.start.slice(0,16).replace(\'T\',\' \'))}${w.current?\' <span class="tag" style="border-color:var(--acc);color:var(--acc)">current</span>\':\'\'}</strong>\n          <span class="cwhere">${kfmt(tot)} output · Fable ${kfmt(fable)}</span></div>\n        ${models.length?`<div style="margin:8px 0 6px;display:flex;gap:12px;flex-wrap:wrap;font-size:12.5px">`+\n          models.map(([m,v])=>`<span style="color:${color(m)}">${esc(shortModel(m))} <b>${kfmt(v.output)}</b> <span class="cwhere">${v.replies}×</span></span>`).join(\'\')+`</div>\n          <div style="margin-top:6px">`+w.days.map(x=>{const t=Object.values(x.models).reduce((a,b)=>a+b,0);\n            return `<div class="barrow"><span class="cwhere">${esc(x.day.slice(5))} ${dayNames[(new Date(x.day+\'T12:00\').getDay()+6)%7]}</span>\n              <div style="display:flex;gap:1px;height:8px">${Object.entries(x.models).map(([m,v])=>`<div title="${esc(shortModel(m))}: ${kfmt(v)}" style="height:8px;background:${color(m)};width:${(v/maxDay*100).toFixed(1)}%;border-radius:2px"></div>`).join(\'\')}</div>\n              <span class="num cwhere">${kfmt(t)}</span></div>`}).join(\'\')+`</div>`\n         :\'<div class="cwhere" style="margin-top:6px">nothing for this account on this Mac</div>\'}\n      </div>`}).join(\'\');\n  bar.wire();\n  $(\'accExtra\').innerHTML=`<button class="p" id="useExport" ${bar.exportable?\'\':\'disabled title="Pick an app or account first"\'}>Export this Mac\'s usage</button>`;\n  $(\'useExport\').onclick=async()=>{\n    const name=prompt(\'Your name, as it should appear in the combined table:\',localStorage.getItem(\'pt_name\')||\'\');\n    if(name===null)return; localStorage.setItem(\'pt_name\',name);\n    window.open(`/api/usage_export?name=${encodeURIComponent(name)}&scope=${encodeURIComponent(bar.scope)}&t=${T}`,\'_blank\');\n  };\n}\n\nasync function loadCompare(){\n  $(\'useSub\').textContent=\'everyone exports from their own Mac, you combine them here\';\n  $(\'useBody\').innerHTML=\n    `<div class="warn" style="margin-bottom:12px;border-width:2px">\n       <div style="font-size:15px;font-weight:700;margin-bottom:6px">This counts Claude Code only.</div>\n       <div>✓ Claude Code in a terminal &nbsp;·&nbsp; ✓ the Code tab inside the Claude app</div>\n       <div>✗ Claude <em>chat</em>, on claude.ai or in the app\'s chat window. Those live on Anthropic\'s servers,\n         not on anyone\'s Mac, so no export can see them.</div>\n       <div style="margin-top:6px">Every file must be exported for the <strong>same shared account</strong>. A file for a\n         different account is set aside, not mixed in.</div></div>\n     <div class="dmeta" style="white-space:normal;margin-bottom:10px">Each person opens PowerTools on their Mac →\n       <strong>week by week</strong> → <strong>Export this Mac\'s usage</strong>, types their name, picks the shared account,\n       and sends you the JSON. Pick all the files here at the end of the week.</div>\n     <div class="mgroup">who is actually on this account</div>\n     <div class="dmeta" style="white-space:normal;margin-bottom:6px">You will forget who you lent it to. Anthropic does not.\n       Open <strong>claude.ai → Settings → Active sessions</strong>, select the whole table, copy, and paste it here.\n       Only <em>Claude Desktop</em> rows can be Claude Code, browser rows are chat and never reach any Mac.</div>\n     <textarea id="cmpSessions" placeholder="paste the Active sessions table here" style="width:100%;min-height:70px;padding:8px 10px;border:1px solid var(--line);border-radius:8px;background:var(--card);color:var(--fg);font:12px ui-monospace,Menlo,monospace">${esc(localStorage.getItem(\'pt_sessions\')||\'\')}</textarea>\n     <div id="cmpSessOut" style="margin:8px 0 12px"></div>\n     <div class="mgroup">the account meter, and what it is worth in tokens</div>\n     <div class="warn" style="margin-bottom:8px"><strong>This is an estimate, and it cannot be anything else.</strong>\n       The meter is the only place claude.ai chat shows up, and Anthropic never says how many tokens 100% is.\n       So: read the meter twice while <em>only your Mac</em> uses the account (overnight works), and PowerTools works out\n       tokens-per-percent from what your Mac spent in between. Fable is one model so its bar calibrates cleanly;\n       the all-models bar mixes model weights, so treat that one loosely.</div>\n     <div style="display:grid;grid-template-columns:auto 1fr 1fr;gap:6px 10px;align-items:center;font-size:12.5px;margin-bottom:8px">\n       <span></span><span class="cwhere">reading 1</span><span class="cwhere">reading 2</span>\n       <span>when</span><input type="datetime-local" id="c1t"><input type="datetime-local" id="c2t">\n       <span>Weekly · Fable %</span><input type="text" id="c1f" placeholder="e.g. 13" style="width:70px"><input type="text" id="c2f" placeholder="e.g. 14" style="width:70px">\n       <span>Weekly · all models %</span><input type="text" id="c1a" placeholder="e.g. 15" style="width:70px"><input type="text" id="c2a" placeholder="e.g. 16" style="width:70px">\n     </div>\n     <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:6px">\n       <button id="calGo">Calibrate from this Mac\'s usage between the readings</button>\n       <span id="calOut" class="cwhere"></span></div>\n     <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:12px">\n       <span class="cwhere">meter right now:</span>\n       <span>Fable %</span><input type="text" id="mF" style="width:60px" value="${esc(localStorage.getItem(\'pt_mF\')||\'\')}">\n       <span>all models %</span><input type="text" id="mA" style="width:60px" value="${esc(localStorage.getItem(\'pt_mA\')||\'\')}">\n       <span class="cwhere">from the app\'s limits panel, this week</span></div>\n     <button class="p" id="cmpPick">Choose everyone\'s exports…</button>\n     <div id="cmpOut" style="margin-top:14px"></div>`;\n  $(\'cmpSessions\').oninput=()=>{localStorage.setItem(\'pt_sessions\',$(\'cmpSessions\').value);drawSessions()};\n  drawSessions();\n  const cal=JSON.parse(localStorage.getItem(\'pt_cal\')||\'{}\');\n  if(cal.tokPerPctFable||cal.tokPerPctAll)$(\'calOut\').textContent=`calibrated: 1% Fable ≈ ${cal.tokPerPctFable?kfmt(cal.tokPerPctFable):\'?\'} output tokens · 1% all ≈ ${cal.tokPerPctAll?kfmt(cal.tokPerPctAll):\'?\'}`;\n  [\'c1t\',\'c2t\',\'c1f\',\'c2f\',\'c1a\',\'c2a\'].forEach(id=>{if(cal[id])$(id).value=cal[id]});\n  $(\'mF\').oninput=()=>localStorage.setItem(\'pt_mF\',$(\'mF\').value); $(\'mA\').oninput=()=>localStorage.setItem(\'pt_mA\',$(\'mA\').value);\n  $(\'calGo\').onclick=async()=>{\n    const v=id=>$(id).value.trim();\n    if(!v(\'c1t\')||!v(\'c2t\'))return alert(\'Both reading times are needed.\');\n    const scope=localStorage.getItem(\'pt_scope\')||\'\';\n    const r=await api(`/api/usage_between?scope=${encodeURIComponent(scope)}&from=${encodeURIComponent(v(\'c1t\'))}&to=${encodeURIComponent(v(\'c2t\'))}`);\n    const dF=parseFloat(v(\'c2f\'))-parseFloat(v(\'c1f\')), dA=parseFloat(v(\'c2a\'))-parseFloat(v(\'c1a\'));\n    const out={c1t:v(\'c1t\'),c2t:v(\'c2t\'),c1f:v(\'c1f\'),c2f:v(\'c2f\'),c1a:v(\'c1a\'),c2a:v(\'c2a\')};\n    if(dF>0&&r.fable.output>0)out.tokPerPctFable=Math.round(r.fable.output/dF);\n    if(dA>0&&r.all.output>0)out.tokPerPctAll=Math.round(r.all.output/dA);\n    localStorage.setItem(\'pt_cal\',JSON.stringify(out));\n    $(\'calOut\').textContent=(out.tokPerPctFable||out.tokPerPctAll)\n      ?`between readings this Mac spent Fable ${kfmt(r.fable.output)} / all ${kfmt(r.all.output)} → 1% Fable ≈ ${out.tokPerPctFable?kfmt(out.tokPerPctFable):\'?\'} · 1% all ≈ ${out.tokPerPctAll?kfmt(out.tokPerPctAll):\'?\'}`\n      :`the meter did not move (Fable ${dF||0}%, all ${dA||0}%) or this Mac spent nothing in between - try a longer gap`;\n  };\n  $(\'cmpPick\').onclick=async()=>{\n    const p=await api(\'/api/pick_many\');\n    if(!p.ok||!p.paths.length)return;\n    renderCombined(p.paths);\n  };\n}\n/* the Active sessions table, pasted. rows carry device, location, created, last-updated */\nfunction parseSessions(text){\n  const DATE=/([A-Z][a-z]{2} \\d{1,2}, \\d{4}, \\d{1,2}:\\d{2} [AP]M)/g;\n  const rows=[]; let buf=\'\';\n  for(const raw of text.split(/\\n/)){\n    const line=raw.trim(); if(!line||/^(Device|Location|Created|Updated|Active sessions|Showing)/i.test(line))continue;\n    buf+=(buf?\' \':\'\')+line;\n    const dates=[...buf.matchAll(DATE)].map(m=>m[1]);\n    if(dates.length>=2){\n      const head=buf.slice(0,buf.indexOf(dates[0])).trim();\n      const m=head.match(/^(.*?\\))\\s*(Current)?\\s*(.*)$/);\n      rows.push({device:(m?m[1]:head).trim(), current:/Current/.test(head), location:(m?m[3]:\'\').trim(),\n                 created:new Date(dates[0]), updated:new Date(dates[1])});\n      buf=\'\';\n    }\n  }\n  return rows;\n}\nwindow.__sessions=[];\nfunction drawSessions(){\n  const rows=parseSessions($(\'cmpSessions\').value||\'\'); window.__sessions=rows;\n  if(!rows.length){$(\'cmpSessOut\').innerHTML=\'\';return}\n  const desktop=rows.filter(r=>/Claude Desktop/i.test(r.device));\n  const weekAgo=Date.now()-7*864e5;\n  const active=desktop.filter(r=>r.updated.getTime()>weekAgo);\n  // sessions are login tokens, not people: one Mac with two Claude apps and a re-login is three rows.\n  // rows from one place created within a day of each other are almost certainly one machine.\n  const groups=[];\n  active.slice().sort((a,b)=>a.created-b.created).forEach(r=>{\n    const g=groups.find(x=>x.location===r.location&&Math.abs(x.created-r.created)<864e5);\n    if(g){g.n++}else groups.push({location:r.location,created:r.created,n:1});\n  });\n  const places=new Set(active.map(r=>r.location)).size;\n  window.__expectedFiles=groups.length;\n  $(\'cmpSessOut\').innerHTML=\n    `<div class="warn"><strong>${rows.length} sessions</strong> on the account, but a session is a login, not a person.\n     One Mac with two Claude apps, a browser tab and a re-login is four or five rows on its own.<br>\n     ${desktop.length} rows are Claude Desktop · ${active.length} active this week · from <strong>${places} location${places===1?\'\':\'s\'}</strong>.\n     <div style="margin-top:6px">Rough machine count: <strong>${groups.length}</strong>\n       <span class="cwhere">(sessions from one place set up within a day of each other counted as one machine; between ${places} and ${active.length} is possible)</span>.\n       Expect about <strong>${groups.length}</strong> export file${groups.length===1?\'\':\'s\'}.</div>\n     <div class="dmeta" style="white-space:normal;margin-top:6px">Location is the sign-in IP\'s city, so a VPN moves it. Clean this up once:\n       log out every session from that page, then sign back in only where you mean to. From then on, each new row is one deliberate grant.</div></div>\n     <table class="conn"><thead><tr><th>Device</th><th>Location</th><th>Created</th><th>Last active</th><th></th></tr></thead><tbody>`+\n    rows.map(r=>`<tr style="${/Claude Desktop/i.test(r.device)?\'\':\'opacity:.45\'}"><td>${esc(r.device)}${r.current?\' <span class="tag">this Mac</span>\':\'\'}</td>\n      <td><span class="cwhere">${esc(r.location)}</span></td>\n      <td><span class="cwhere">${r.created.toLocaleDateString()}</span></td>\n      <td><span class="cwhere">${r.updated.toLocaleString([],{dateStyle:\'short\',timeStyle:\'short\'})}</span></td>\n      <td><span class="cwhere">${/Claude Desktop/i.test(r.device)?(r.updated.getTime()>weekAgo?\'active this week\':\'idle\'):\'browser chat, not countable\'}</span></td></tr>`).join(\'\')+\n    `</tbody></table>\n     <div class="dmeta" style="white-space:normal;margin-top:6px">Do not recognise one? Log it out from that same page. That is the fix for the one-day lends you forgot.</div>`;\n}\nasync function renderCombined(paths){\n  $(\'cmpOut\').innerHTML=\'<div class="empty">combining…</div>\';\n  const weekAgo=Date.now()-7*864e5;\n  const expected=window.__expectedFiles||0;\n  const r=await api(\'/api/usage_combine\',{method:\'POST\',headers:{\'content-type\':\'application/json\'},body:JSON.stringify({files:paths,expected})});\n  if(!r.ok){$(\'cmpOut\').innerHTML=`<div class="warn">${esc(r.msg)}</div>`;return}\n  $(\'cmpOut\').innerHTML=\n    `<div class="warn" style="margin-bottom:10px">Shared account: <strong>${esc(r.account)}</strong> · ${r.people} file(s) received${r.expected?` · about ${r.expected} machine(s) used Claude Desktop this week`:\'\'}\n       ${r.missing?`<div style="margin-top:6px;color:var(--warn)"><strong>About ${r.missing} machine${r.missing>1?\'s\':\'\'} used the account this week and sent no file.</strong>\n         That estimate comes from the sessions table, so treat it as a lead, not a verdict. Their usage is real but invisible here, so the shares\n         below are split only among the ${r.people} who did. If the account meter is higher than these add up to, the gap is theirs.</div>`:\'\'}\n       ${(!r.expected)?`<div class="dmeta" style="white-space:normal;margin-top:6px">Paste the Active sessions table above and this will tell you whether anyone is missing.</div>`:\'\'}\n       <div class="dmeta" style="white-space:normal;margin-top:6px">Share = each person\'s slice of the total across the files you picked, for <strong>all models</strong> and for Fable separately, matching the two weekly bars in the app.</div></div>`+\n    (r.reset_mismatch?`<div class="warn" style="border-color:var(--warn);margin-bottom:10px"><strong>Reset times disagree, so the weeks will not line up:</strong>`+\n      Object.entries(r.reset_mismatch).map(([k,who])=>`<div>${esc(k.replace(/^(\\d) /,(m,d)=>dayNames[+d]+\' \'))} — ${esc(who.join(\', \'))}</div>`).join(\'\')+\n      `<div style="margin-top:4px">Everyone on one account should use the same reset. Ask them to re-export after setting it.</div></div>`:\'\')+\n    (r.rejected.length?`<div class="warn" style="border-color:var(--warn);margin-bottom:10px"><strong>Set aside, not counted:</strong>`+\n      r.rejected.map(x=>`<div>${esc(x.who||x.file.split(\'/\').pop())} — ${esc(x.why)}</div>`).join(\'\')+`</div>`:\'\')+\n    r.weeks.slice().reverse().map(w=>`<div style="border:1px solid var(--line);border-radius:10px;padding:12px 14px;margin-bottom:12px;background:var(--card)${w.current?\';border-color:var(--acc)\':\'\'}">\n      <strong>Week from ${esc(w.start.slice(0,16).replace(\'T\',\' \'))}${w.current?\' <span class="tag" style="border-color:var(--acc);color:var(--acc)">current</span>\':\'\'}</strong>\n      <table class="conn" style="margin-top:8px"><thead><tr><th>Who</th><th class="num">Fable</th><th class="num">Share</th><th class="num">All models</th><th class="num">Share</th></tr></thead><tbody>`+\n      w.rows.map(row=>`<tr><td><b>${esc(row.who)}</b><div class="cwhere">${row.instance?esc(row.instance)+\' · \':\'\'}${esc(row.machine||\'\')}${row.ips&&row.ips.length?\' · \'+esc(row.ips.join(\', \')):\'\'}${row.terminal===false?\' · terminal sessions not counted\':\'\'}</div></td>\n        <td class="num">${kfmt(row.fable)}</td>\n        <td class="num"><div style="display:flex;gap:6px;align-items:center;justify-content:flex-end"><div class="bar" style="width:${Math.max(2,row.fable_share)}px;max-width:80px"></div>${row.fable_share}%</div></td>\n        <td class="num">${kfmt(row.total)}</td><td class="num">${row.total_share}%</td></tr>`).join(\'\')+\n      `</tbody></table></div>`+\n      (w.current?meterSplit(w):\'\')).join(\'\');\n}\nfunction meterSplit(w){\n  const cal=JSON.parse(localStorage.getItem(\'pt_cal\')||\'{}\');\n  const mF=parseFloat($(\'mF\').value), mA=parseFloat($(\'mA\').value);\n  const pal=[\'var(--acc)\',\'#6a8fd8\',\'#7fb069\',\'#c98bd8\',\'#d8b36a\',\'#8ab4b8\',\'#b88a7a\'];\n  /* one bar per meter, drawn like the app\'s panel: the meter\'s % is the filled part,\n     split into a coloured piece per person, grey for whatever nobody\'s file explains */\n  const bar=(label,meterPct,tokPerPct,pick)=>{\n    if(!(meterPct>0))return `<div class="mrow" style="cursor:default"><div class="mn">${label}</div><div class="md">type this week\'s ${label.toLowerCase()} % from the app\'s panel above to draw it</div></div>`;\n    if(!tokPerPct)return `<div class="mrow" style="cursor:default"><div class="mn">${label} · meter ${meterPct}%</div><div class="md">calibrate once (above) and this bar splits by person</div></div>`;\n    const parts=w.rows.map((r,i)=>({who:r.who,pct:pick(r)/tokPerPct,color:pal[i%pal.length]}));\n    const known=parts.reduce((a,p)=>a+p.pct,0), rest=Math.max(0,meterPct-known), over=Math.max(0,known-meterPct);\n    const seg=(pct,color,title)=>`<div title="${esc(title)}" style="width:${(pct/Math.max(meterPct,known)*100).toFixed(2)}%;background:${color};height:100%"></div>`;\n    return `<div class="mrow" style="cursor:default">\n      <div style="display:flex;justify-content:space-between;align-items:baseline;gap:10px">\n        <div class="mn">${label}</div><div class="cwhere">meter <b>${meterPct}%</b> of the weekly limit</div></div>\n      <div style="height:12px;border-radius:6px;background:var(--line);overflow:hidden;margin:8px 0 6px;display:flex;width:${Math.min(100,meterPct*2)}%;min-width:120px">`+\n        parts.map(p=>seg(p.pct,p.color,`${p.who}: ≈ ${p.pct.toFixed(1)}% of the limit (${(p.pct/meterPct*100).toFixed(0)}% of what was used)`)).join(\'\')+\n        (rest>0.05?seg(rest,\'rgba(128,128,128,.55)\',`unaccounted: ≈ ${rest.toFixed(1)}% — claude.ai chat, Claude Design, someone who did not export, or calibration drift`):\'\')+\n      `</div>\n      <div style="display:flex;gap:12px;flex-wrap:wrap;font-size:12px">`+\n        parts.map(p=>`<span title="${esc(p.who)}"><span style="display:inline-block;width:9px;height:9px;border-radius:2px;background:${p.color};margin-right:4px;vertical-align:middle"></span>${esc(p.who)} <b>≈${p.pct.toFixed(1)}%</b></span>`).join(\'\')+\n        (rest>0.05?`<span><span style="display:inline-block;width:9px;height:9px;border-radius:2px;background:rgba(128,128,128,.55);margin-right:4px;vertical-align:middle"></span>unaccounted <b style="color:var(--warn)">≈${rest.toFixed(1)}%</b></span>`:\'\')+\n        (over>0.5?`<span class="cwhere">files add up to ${over.toFixed(1)}% more than the meter — calibration is off, re-do it</span>`:\'\')+\n      `</div></div>`;\n  };\n  return `<div class="warn" style="margin-top:10px;padding:12px 14px">\n    <div style="font-weight:700;margin-bottom:8px">This week, the account meter split by person <span class="cwhere" style="font-weight:400">(estimate · hover a bar segment)</span></div>`+\n    bar(\'Weekly · Fable\',mF,cal.tokPerPctFable,r=>r.fable)+\n    bar(\'Weekly · all models\',mA,cal.tokPerPctAll,r=>r.total)+\n    `<div class="dmeta" style="white-space:normal;margin-top:4px">Grey = the part of the meter no file explains. It is not proof against anyone.</div></div>`;\n}\nasync function loadWindows(){\n  $(\'useBody\').innerHTML=\'<div class="empty">checking the current windows…</div>\';\n  const bar=await accountBar(loadWindows);\n  const d=await api(`/api/usage_windows?scope=${encodeURIComponent(bar.scope)}`);\n  const wd=d.reset.weekday, at=d.reset.hhmm;\n  $(\'useSub\').textContent=`${d.now.replace(\'T\',\' \')} · ${d.scope.label} · same windows the Claude app meters`;\n  const card=(title,w,note)=>{\n    const models=Object.entries(w.models).sort((a,b)=>b[1].output-a[1].output);\n    const fable=models.filter(([m])=>m.includes(\'fable\')).reduce((a,[,v])=>({replies:a.replies+v.replies,output:a.output+v.output}),{replies:0,output:0});\n    return `<div style="border:1px solid var(--line);border-radius:10px;padding:12px 14px;margin-bottom:14px;background:var(--card)">\n      <div style="display:flex;justify-content:space-between;gap:10px;align-items:baseline;flex-wrap:wrap">\n        <strong style="font-size:14px">${title}</strong><span class="cwhere">since ${esc(w.since.slice(0,16).replace(\'T\',\' \'))}</span></div>\n      <div class="dmeta" style="white-space:normal;margin:4px 0 10px">${note}</div>\n      <div class="warn" style="margin-bottom:10px"><strong>Fable from this Mac in this window: ${fable.replies} replies, ${kfmt(fable.output)} output tokens.</strong>\n        ${fable.replies?\'\':\' Nothing. Whatever the account meter shows for Fable, it did not come from here.\'}</div>\n      ${models.length?`<table class="conn"><thead><tr><th>Model</th><th class="num">Replies</th><th class="num">Output</th><th class="num">Input + cache</th></tr></thead><tbody>`+\n        models.map(([m,v])=>`<tr><td><b style="color:${color(m)}">${esc(shortModel(m))}</b></td><td class="num">${v.replies}</td><td class="num">${kfmt(v.output)}</td><td class="num">${kfmt(v.input)}</td></tr>`).join(\'\')+\n        `</tbody></table>\n        <div class="mgroup">by Claude app</div>\n        <table class="conn"><tbody>`+Object.entries(w.apps).map(([app,ms])=>`<tr><td><b>${esc(app)}</b></td><td>`+\n          Object.entries(ms).sort((a,b)=>b[1].output-a[1].output).map(([m,v])=>`<span style="margin-right:12px;color:${color(m)}">${esc(shortModel(m))} <b>${kfmt(v.output)}</b> <span class="cwhere">${v.replies}×</span></span>`).join(\'\')+`</td></tr>`).join(\'\')+\n        `</tbody></table>\n        <div class="mgroup">chats in this window</div>\n        <table class="conn"><tbody>`+w.chats.map(ch=>`<tr><td>${esc(ch.title)}</td><td><span class="cwhere">${esc(ch.app)}</span></td><td>`+\n          Object.entries(ch.models).map(([m,v])=>`<span style="margin-right:10px;color:${color(m)}">${esc(shortModel(m))} ${kfmt(v.output)}</span>`).join(\'\')+`</td></tr>`).join(\'\')+`</tbody></table>`\n       :\'<div class="empty" style="padding:14px">nothing for this account on this Mac in this window</div>\'}\n    </div>`;\n  };\n  const allModels=[...new Set([...Object.keys(d.windows[\'5h\'].models),...Object.keys(d.windows.week.models)])];colorFor(allModels);\n  $(\'useBody\').innerHTML=\n    `<div class="warn" style="margin-bottom:14px">The Claude app shows the <em>whole account\'s</em> percentage. Anthropic does not\n      publish how many tokens 100% is, and the live percentage is fetched through your login and never stored on this Mac, so\n      it cannot be turned into "my share". What this Mac <em>did</em> use in the same windows is exact, and that is the evidence.</div>`+\n    bar.html+\n    card(\'Rolling 5-hour window\', d.windows[\'5h\'], \'What the app calls the 5-hour limit.\')+\n    card(\'Weekly window\', d.windows.week, `Since the last ${dayNames[wd]} ${esc(at)} reset for this account.`);\n  bar.wire();\n}\nasync function loadUsage(){\n  const v=$(\'useView\').value;\n  $(\'useDays\').hidden=v!==\'days\';\n  if(v===\'windows\')return loadWindows();\n  if(v===\'weeks\')return loadWeeks();\n  if(v===\'compare\')return loadCompare();\n  $(\'useBody\').innerHTML=\'<div class="empty">adding up…</div>\';\n  const days=$(\'useDays\').value;\n  const d=await api(\'/api/usage?days=\'+days);\n  const totOut=d.by_model.reduce((a,m)=>a+m.output,0)||1;\n  $(\'useSub\').textContent=`${d.machine} · since ${d.since} · records go back to ${d.first_day||\'?\'}`;\n  // per-day, stacked by model as bars\n  const days_={};d.by_day.forEach(r=>{(days_[r.day]=days_[r.day]||{}).__t=(days_[r.day].__t||0)+r.output;days_[r.day][r.model]=r.output});\n  const dayKeys=Object.keys(days_).sort();const maxDay=Math.max(1,...dayKeys.map(k=>days_[k].__t));\n  const models=d.by_model.map(m=>m.model);\n  const palette=[\'var(--acc)\',\'#6a8fd8\',\'#7fb069\',\'#c98bd8\',\'#d8b36a\',\'#8ab4b8\',\'#b88a7a\',\'#999\'];\n  const color=m=>palette[models.indexOf(m)%palette.length];\n  $(\'useBody\').innerHTML=\n   `<div class="mgroup">by model · ${$(\'useDays\').selectedOptions[0].textContent} — output tokens are what Claude wrote back</div>\n    <table class="conn"><thead><tr><th>Model</th><th class="num">Replies</th><th class="num">Output</th>\n      <th class="num">Thinking</th><th class="num">Input + cache</th><th>Share</th></tr></thead><tbody>`+\n    d.by_model.map(m=>`<tr><td><span style="display:inline-block;width:10px;height:10px;border-radius:3px;background:${color(m.model)};margin-right:7px"></span><b>${esc(shortModel(m.model))}</b></td>\n      <td class="num">${m.requests}</td><td class="num">${kfmt(m.output)}</td><td class="num">${kfmt(m.thinking)}</td>\n      <td class="num">${kfmt(m.input+m.cache_create)}</td>\n      <td><div class="bar" title="${esc(shortModel(m.model))}: ${Math.round(m.output/totOut*100)}% of output" style="background:${color(m.model)};width:${Math.max(2,Math.round(m.output/totOut*100))}%"></div></td></tr>`).join(\'\')+\n    `</tbody></table>\n    <div style="display:flex;gap:12px;flex-wrap:wrap;margin:8px 0 2px;font-size:12px;color:var(--dim)">`+\n    models.map(m=>`<span><span style="display:inline-block;width:10px;height:10px;border-radius:3px;background:${color(m)};margin-right:5px;vertical-align:middle"></span>${esc(shortModel(m))}</span>`).join(\'\')+\n    `</div>\n    <div class="mgroup">by day</div>\n    <div style="border:1px solid var(--line);border-radius:9px;padding:10px 12px;background:var(--card)">`+\n    dayKeys.map(k=>`<div class="barrow"><span class="cwhere">${k.slice(5)}</span>\n      <div style="display:flex;gap:1px;height:8px">${models.filter(m=>days_[k][m]).map(m=>\n        `<div title="${esc(shortModel(m))}: ${kfmt(days_[k][m])}" style="height:8px;background:${color(m)};width:${(days_[k][m]/maxDay*100).toFixed(1)}%;border-radius:2px"></div>`).join(\'\')}</div>\n      <span class="num cwhere">${kfmt(days_[k].__t)}</span></div>`).join(\'\')+\n    `</div>\n    <div class="mgroup">by Claude app · ${$(\'useDays\').selectedOptions[0].textContent}</div>\n    <div class="tw"><table class="conn"><thead><tr><th>Claude app</th>`+\n      (()=>{const shown=d.by_model.filter(m=>m.output>0).map(m=>m.model);window._pm=shown;\n        return shown.map(m=>`<th class="num" style="color:${color(m)};white-space:nowrap">${esc(shortModel(m))}</th>`).join(\'\')})()+\n      `<th class="num">Total</th></tr></thead><tbody>`+\n    (()=>{const apps={};d.by_instance.forEach(r=>{(apps[r.app]=apps[r.app]||{})[r.model]=r.output});\n      return Object.keys(apps).sort((a,b)=>Object.values(apps[b]).reduce((x,y)=>x+y,0)-Object.values(apps[a]).reduce((x,y)=>x+y,0))\n        .map(app=>`<tr><td style="white-space:nowrap"><b>${esc(app)}</b></td>`+\n          window._pm.map(m=>`<td class="num" title="${esc(app)} · ${esc(shortModel(m))}">${apps[app][m]?kfmt(apps[app][m]):\'<span style="opacity:.3">–</span>\'}</td>`).join(\'\')+\n          `<td class="num"><b>${kfmt(Object.values(apps[app]).reduce((x,y)=>x+y,0))}</b></td></tr>`).join(\'\')})()+\n    `</tbody></table></div>\n    <div class="dmeta" style="margin:-6px 0 4px">Terminal only = Claude Code sessions started from a terminal that were never opened in any Claude app.</div>\n    <div class="mgroup">by account and Claude app · ${$(\'useDays\').selectedOptions[0].textContent}</div>\n    <table class="conn"><thead><tr><th>Account</th><th>App</th><th>Model</th><th class="num">Replies</th><th class="num">Output</th></tr></thead><tbody>`+\n    d.by_account.map(r=>`<tr><td>${esc(r.label)}</td><td><span class="cwhere">${esc(r.instance||\'—\')}</span></td>\n      <td><span class="cwhere">${esc(shortModel(r.model))}</span></td><td class="num">${r.requests}</td><td class="num">${kfmt(r.output)}</td></tr>`).join(\'\')+\n    `</tbody></table>\n    <div class="mgroup" style="display:flex;gap:10px;align-items:center">chats\n      <span class="tabs" style="margin:0"><span class="tab${window._chatSort!==\'recent\'?\' on\':\'\'}" data-cs="used">most used</span>\n      <span class="tab${window._chatSort===\'recent\'?\' on\':\'\'}" data-cs="recent">most recent</span></span></div>\n    <table class="conn"><thead><tr><th>Chat</th><th>App</th><th>Model</th><th>Last</th><th class="num">Replies</th><th class="num">Output</th></tr></thead><tbody>`+\n    (window._chatSort===\'recent\'?d.recent_chats:d.top_chats).map(t=>`<tr><td>${t.reg_path?`<span class="ttl" data-cli="${esc(t.cli_id)}">${esc(t.title)}</span>`:`<span class="cwhere">${esc(t.title)}</span>`}</td>\n      <td><span class="cwhere">${esc(t.app)}</span></td>\n      <td><span class="cwhere" style="color:${color(t.model)}">${esc(shortModel(t.model))}</span></td>\n      <td><span class="cwhere">${esc(t.last_day||\'\')}</span></td>\n      <td class="num">${t.requests}</td><td class="num">${kfmt(t.output)}</td></tr>`).join(\'\')+\n    `</tbody></table>\n    <div class="warn" style="margin-top:12px">This counts Claude Code conversations stored on this Mac only.\n      Chats made on the claude.ai website or in the Claude app\'s own chat window are kept by Anthropic,\n      not here, so they do not appear. Other people\'s Macs are not visible from this one.</div>`;\n  $(\'useBody\').querySelectorAll(\'[data-cs]\').forEach(t=>t.onclick=()=>{window._chatSort=t.dataset.cs;loadUsage()});\n  $(\'useBody\').querySelectorAll(\'.ttl[data-cli]\').forEach(n=>n.onclick=async()=>{\n    let r=rows.find(x=>x.cli_id===n.dataset.cli);\n    if(!r){const dd=await api(\'/api/sessions?q=&limit=100000\');r=dd.rows.find(x=>x.cli_id===n.dataset.cli)}\n    if(r){$(\'ovuse\').classList.remove(\'on\');openChat(r)}\n  });\n}\n$(\'usebtn\').onclick=()=>{$(\'ovuse\').classList.add(\'on\');loadUsage()};\n$(\'useClose\').onclick=()=>$(\'ovuse\').classList.remove(\'on\');\n$(\'useDays\').onchange=loadUsage;\n$(\'useView\').onchange=loadUsage;\n$(\'useCsv\').onclick=()=>window.open(`/api/usage.csv?days=${$(\'useDays\').value}&t=${T}`,\'_blank\');\n\n/* ---------- settings ---------- */\nasync function loadSettings(){\n  $(\'setBody\').innerHTML=\'<div class="empty">reading…</div>\';\n  const d=await api(\'/api/settings\');\n  $(\'setFile\').textContent=d.file;\n  $(\'setBody\').innerHTML=d.settings.map(s=>{\n    const shown=s.set?s.value:s.default;\n    const ctl=s.type===\'bool\'\n      ? `<label class="ck" style="color:var(--fg)"><input type="checkbox" data-k="${esc(s.key)}"\n          ${shown?\'checked\':\'\'}> ${shown?\'on\':\'off\'}</label>`\n      : s.type===\'number\'\n        ? `<div style="display:flex;gap:6px;align-items:center">\n             <input type="text" data-n="${esc(s.key)}" value="${esc(String(shown))}" style="width:90px">\n             <span class="cwhere">${esc(s.unit||\'\')}</span>\n             <button data-save="${esc(s.key)}">Save</button></div>`\n        : `<span class="cwhere">${esc(String(shown))}</span>`;\n    return `<div style="border:1px solid var(--line);border-radius:9px;padding:10px 12px;\n              margin-bottom:8px;background:var(--card)${s.risky?\';border-color:var(--warn)\':\'\'}">\n      <div style="display:flex;justify-content:space-between;gap:12px;align-items:flex-start">\n        <div style="min-width:0">\n          <strong>${esc(s.title)}</strong>${s.risky?\' <span class="tag off">careful</span>\':\'\'}\n          <div class="dmeta" style="margin-top:3px;white-space:normal">${esc(s.why)}</div>\n          ${s.set?\'\':\'<div class="dmeta" style="margin-top:3px">not set, so Claude uses its default</div>\'}\n        </div>\n        <div style="flex:0 0 auto">${ctl}</div>\n      </div></div>`;\n  }).join(\'\')+\n  `<div class="warn">Changes land in <code>${esc(d.file)}</code>. A copy of the file is kept\n    before each change. New Claude Code sessions pick them up; one already running keeps\n    the old value.</div>`;\n  $(\'setBody\').querySelectorAll(\'input[data-k]\').forEach(c=>c.onchange=async e=>{\n    await saveSetting(e.target.dataset.k, e.target.checked);\n  });\n  $(\'setBody\').querySelectorAll(\'button[data-save]\').forEach(b=>b.onclick=async e=>{\n    const k=e.currentTarget.dataset.save;\n    await saveSetting(k, $(\'setBody\').querySelector(`input[data-n="${CSS.escape(k)}"]`).value);\n  });\n}\nasync function saveSetting(key,value){\n  const r=await api(\'/api/setting\',{method:\'POST\',headers:{\'content-type\':\'application/json\'},\n    body:JSON.stringify({key,value})});\n  toast(r.ok?`${key} is now ${r.now}. ${r.msg}`:(\'Not changed: \'+r.msg));\n  loadSettings();\n}\n$(\'setbtn\').onclick=()=>{$(\'ovset\').classList.add(\'on\');loadSettings()};\n$(\'setClose\').onclick=()=>$(\'ovset\').classList.remove(\'on\');\n\n/* ---------- backup ---------- */\nlet bk=null;\nconst mb=b=>b>1e9?(b/1e9).toFixed(1)+\' GB\':(b/1e6).toFixed(0)+\' MB\';\nasync function loadBackup(){\n  $(\'bkMake\').innerHTML=\'<div class="empty">looking…</div>\';\n  bk=await api(\'/api/backup_info\');\n  $(\'bkSub\').textContent=\'one zip carries your chats, memory and settings to a new Mac\';\n  drawMake();drawUse();\n}\nfunction drawMake(){\n  const h=bk.here;\n  $(\'bkMake\').innerHTML=\n    `<div class="mgroup">what is on this Mac</div>\n     <table class="conn"><tbody>\n      <tr><td>Chats</td><td style="text-align:right">${h.registrations}</td></tr>\n      <tr><td>Transcripts (the actual conversations)</td><td style="text-align:right">${h.transcripts} · ${mb(h.bytes)}</td></tr>\n      <tr><td>Memory notes</td><td style="text-align:right">${h.memories}</td></tr>\n      <tr><td>MCP servers</td><td style="text-align:right">${h.mcp}</td></tr>\n     </tbody></table>\n     <div class="mgroup">save it as</div>\n     <div style="display:flex;gap:8px;align-items:center">\n       <input type="text" id="bkOut" value="${esc(bk.default_out)}" style="flex:1;min-width:0" readonly>\n       <button id="bkPick">Choose folder…</button></div>\n     <label class="ck" style="margin:12px 0;color:var(--fg)">\n       <input type="checkbox" id="bkTr"> include transcripts (${mb(h.bytes)}, takes a while)</label>\n     <div class="warn">Without transcripts you get a small file with every chat\'s title,\n       account, memory and settings, but not the conversation text. For the full\n       ${mb(h.bytes)} version the terminal is steadier:\n       <code>powertools backup</code></div>\n     <button class="p" id="bkGo">Create backup</button>\n     <div id="bkResult" style="margin-top:12px"></div>`;\n  $(\'bkPick\').onclick=async()=>{\n    const r=await api(\'/api/pick?kind=folder\');\n    if(r.ok)$(\'bkOut\').value=r.path.replace(/\\/$/,\'\')+\'/claude-powertools-backup.zip\';\n  };\n  $(\'bkGo\').onclick=async()=>{\n    const b=$(\'bkGo\');b.disabled=true;b.textContent=\'Packing…\';\n    const r=await api(\'/api/backup\',{method:\'POST\',headers:{\'content-type\':\'application/json\'},\n      body:JSON.stringify({out:$(\'bkOut\').value.trim(),transcripts:$(\'bkTr\').checked})});\n    b.disabled=false;b.textContent=\'Create backup\';\n    $(\'bkResult\').innerHTML=`<div class="warn">Done — ${mb(r.bytes)}<br><code>${esc(r.file)}</code>\n      <div style="margin-top:6px">Copy that file to the other Mac, install Claude PowerTools there,\n      then open this same panel and use <strong>Restore one</strong>.</div></div>`;\n    loadBackup();\n  };\n}\nfunction drawUse(){\n  const list=bk.found;\n  $(\'bkUse\').innerHTML=\n    `<div class="mgroup">pick a backup</div>\n     <div style="display:flex;gap:8px;align-items:center;margin-bottom:8px">\n       <input type="text" id="bkFile" placeholder="no file chosen" style="flex:1;min-width:0" readonly>\n       <button class="p" id="bkBrowse">Choose file…</button></div>`+\n    (list.length?`<div class="mgroup">or one already on this Mac</div>\n      <table class="conn"><tbody>`+list.map((f,i)=>\n      `<tr><td><b>${esc(f.file.split(\'/\').pop())}</b>\n        <div class="cwhere">from ${esc(f.machine||\'?\')} · ${esc((f.made||\'\').slice(0,16).replace(\'T\',\' \'))} · ${mb(f.bytes)}</div></td>\n      <td style="text-align:right"><button data-i="${i}">Use this</button></td></tr>`).join(\'\')+\n      `</tbody></table>`:\'\')+\n    `<div id="bkLayout"></div>`;\n  $(\'bkBrowse\').onclick=async()=>{\n    const r=await api(\'/api/pick?kind=file\');\n    if(r.ok){$(\'bkFile\').value=r.path;loadLayout()}\n  };\n  $(\'bkUse\').querySelectorAll(\'button[data-i]\').forEach(b=>b.onclick=()=>{\n    $(\'bkFile\').value=list[+b.dataset.i].file;loadLayout()});\n}\n\nasync function loadLayout(){\n  const f=$(\'bkFile\').value.trim();\n  if(!f)return;\n  $(\'bkLayout\').innerHTML=\'<div class="empty">reading the backup…</div>\';\n  const d=await api(\'/api/backup_layout?file=\'+encodeURIComponent(f));\n  if(!d.ok){$(\'bkLayout\').innerHTML=`<div class="warn">${esc(d.msg||\'could not read that file\')}</div>`;return}\n  const missing=d.rows.filter(r=>!r.instance_here);\n  $(\'bkLayout\').innerHTML=\n    `<div class="mgroup">from ${esc(d.manifest.machine||\'?\')} · ${esc((d.manifest.made||\'\').slice(0,16).replace(\'T\',\' \'))}</div>\n     <table class="conn"><thead><tr><th>Claude app in the backup</th><th>Account</th>\n       <th style="text-align:right">Chats</th><th>On this Mac</th></tr></thead><tbody>`+\n     d.rows.map(r=>`<tr><td><b>${esc(r.instance)}</b></td>\n       <td><span class="cwhere">${esc(r.account.slice(0,8))} · org ${esc(r.org.slice(0,8))}</span></td>\n       <td style="text-align:right">${r.chats}</td>\n       <td><span class="cwhere">${r.exact_here?\'same place exists\':(r.instance_here?\'app exists, different account\':\'app not here\')}</span></td></tr>`).join(\'\')+\n     `</tbody></table>\n     <div class="mgroup">where should the chats land</div>\n     <div class="radios" style="flex-direction:column;gap:6px">\n       <div class="radio on" data-m="keep"><strong>Recreate the same layout</strong>\n         <small>each Claude app gets back the chats it had. Needs those apps to exist here first.</small></div>\n       <div class="radio" data-m="one"><strong>Put every chat into one Claude</strong>\n         <small>everything lands in a single account, whatever app it came from.</small></div>\n     </div>\n     <div id="bkInto" hidden style="margin-top:9px">\n       <select id="bkTarget" style="width:100%">${d.targets.map(t=>`<option>${esc(t)}</option>`).join(\'\')}</select>\n     </div>`+\n     (missing.length?`<div class="warn" style="margin-top:10px">\n        ${missing.map(m=>esc(m.instance)).join(\', \')} ${missing.length===1?\'is\':\'are\'} not on this Mac.\n        Either create ${missing.length===1?\'it\':\'them\'} first in <strong>Instances…</strong>\n        (same name), or choose <strong>one Claude</strong> above.</div>`:\'\')+\n     `<div class="mgroup">what to bring back</div>\n      <label class="ck" style="color:var(--fg)"><input type="checkbox" id="w_tr" checked> transcripts — safe, merges</label>\n      <label class="ck" style="color:var(--fg)"><input type="checkbox" id="w_mem" checked> memory notes — safe, merges</label>\n      <label class="ck" style="color:var(--fg)"><input type="checkbox" id="w_ch" checked> chat list — the chats themselves</label>\n      <label class="ck" style="color:var(--fg)"><input type="checkbox" id="w_cf"> MCP and Claude Code settings — replaces config files</label>\n      <div style="margin:12px 0;display:flex;gap:8px;flex-wrap:wrap">\n        <button id="bkPreview">Preview</button>\n        <button class="p" id="bkRestore" disabled>Restore</button></div>\n      <div id="bkOut2"></div>`;\n  let mode=\'keep\';\n  $(\'bkLayout\').querySelectorAll(\'.radio\').forEach(r=>r.onclick=()=>{\n    $(\'bkLayout\').querySelectorAll(\'.radio\').forEach(x=>x.classList.remove(\'on\'));\n    r.classList.add(\'on\');mode=r.dataset.m;$(\'bkInto\').hidden=mode!==\'one\';\n  });\n  const what=()=>[[\'w_tr\',\'transcripts\'],[\'w_mem\',\'memory\'],[\'w_ch\',\'chats\'],[\'w_cf\',\'config\']]\n    .filter(([id])=>$(id).checked).map(([,v])=>v);\n  const body=dry=>JSON.stringify({file:$(\'bkFile\').value.trim(),what:what(),dry,\n    into:mode===\'one\'?$(\'bkTarget\').value:null});\n  $(\'bkPreview\').onclick=async()=>{\n    $(\'bkOut2\').innerHTML=\'<div class="empty">checking…</div>\';\n    const r=await api(\'/api/restore\',{method:\'POST\',headers:{\'content-type\':\'application/json\'},body:body(true)});\n    if(!r.ok){$(\'bkOut2\').innerHTML=`<div class="warn">${esc(r.msg)}</div>`;return}\n    $(\'bkOut2\').innerHTML=`<div class="warn">Would write <strong>${r.planned}</strong> file(s).\n      <strong>${r.overwrites}</strong> already exist here and would be replaced, with a copy kept first.</div>`+\n      `<div class="plan">`+r.sample.map(x=>`<div><code>${esc(x)}</code></div>`).join(\'\')+`</div>`;\n    $(\'bkRestore\').disabled=r.planned===0;\n  };\n  $(\'bkRestore\').onclick=async()=>{\n    if(!confirm(\'Restore now?\\n\\nThis writes into your live Claude data. Files it replaces are copied aside first.\'))return;\n    const b=$(\'bkRestore\');b.disabled=true;b.textContent=\'Restoring…\';\n    const r=await api(\'/api/restore\',{method:\'POST\',headers:{\'content-type\':\'application/json\'},body:body(false)});\n    b.textContent=\'Restore\';\n    $(\'bkOut2\').innerHTML=`<div class="warn">Wrote ${r.written} file(s).\n      Replaced files kept at <code>${esc(r.backup||\'nothing needed keeping\')}</code>.\n      <div style="margin-top:6px">Quit Claude fully (Cmd+Q) and reopen it.</div></div>`;\n  };\n}\n$(\'bkbtn\').onclick=()=>{$(\'ovbk\').classList.add(\'on\');loadBackup()};\n$(\'bkClose\').onclick=()=>$(\'ovbk\').classList.remove(\'on\');\ndocument.querySelectorAll(\'#ovbk .tab\').forEach(t=>t.onclick=()=>{\n  document.querySelectorAll(\'#ovbk .tab\').forEach(x=>x.classList.remove(\'on\'));\n  t.classList.add(\'on\');\n  $(\'bkMake\').hidden=t.dataset.b!==\'make\';$(\'bkUse\').hidden=t.dataset.b!==\'use\';\n});\n\n/* ---------- mcp ---------- */\nconst EYE=\'<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>\';\nconst EYEOFF=\'<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>\';\n\nlet mcp={servers:[],instances:[]}, mcpTab=\'all\';\nconst initial=n=>(n.replace(/^.*\\./,\'\')[0]||\'?\').toUpperCase();\nasync function loadMcp(){\n  $(\'mcpbody\').innerHTML=\'<div class="empty">reading…</div>\';\n  mcp=await api(\'/api/mcp\');\n  drawMcp();\n}\nfunction drawMcp(){\n  const q=$(\'mcpq\').value.trim().toLowerCase();\n  let list=mcp.servers.filter(m=>!q||(m.name+m.scope+m.target).toLowerCase().includes(q));\n  if(mcpTab===\'instance\')list=list.filter(m=>!m.shared);\n  if(mcpTab===\'shared\')list=list.filter(m=>m.shared);\n  $(\'mcpsub\').textContent=`${mcp.servers.length} servers · ${mcp.instances.length} Claude apps on this Mac`;\n  $(\'mcpbody\').innerHTML=\n   `<div class="tabs">\n      <div class="tab${mcpTab===\'all\'?\' on\':\'\'}" data-t="all">All</div>\n      <div class="tab${mcpTab===\'instance\'?\' on\':\'\'}" data-t="instance">Per app</div>\n      <div class="tab${mcpTab===\'shared\'?\' on\':\'\'}" data-t="shared">Shared</div>\n    </div>`+\n   (list.length?`<table class="conn"><thead><tr>\n      <th>Connector</th><th>Claude app</th><th>Type</th><th></th></tr></thead><tbody>`+\n    list.map(m=>`<tr data-id="${esc(m.id)}">\n      <td><div class="cname"><span class="avatar">${esc(initial(m.name))}</span>\n        <span><b>${esc(m.name)}</b>${m.enabled?\'\':\'<span class="tag off">off</span>\'}\n          ${m.target?`<div class="cwhere">${esc(m.target)}</div>`:\'\'}\n          <div class="keys" data-for="${esc(m.id)}"></div></span></div></td>\n      <td><span class="cwhere">${esc(m.shared?\'every app\':m.scope)}</span></td>\n      <td><span class="cwhere">${esc(m.kind)}</span></td>\n      <td><div class="rowacts">\n        ${m.secrets.length?`<button class="ico" data-act="key" title="Show the stored value">${EYE}</button>`:\'\'}\n        ${m.copyable?`<button data-act="copy">Copy to…</button>`:\'\'}\n      </div></td></tr>`).join(\'\')+`</tbody></table>`\n    :\'<div class="empty">Nothing matches.</div>\')+\n   `<div class="warn" style="margin-top:14px">Servers listed under an app name are configured in\n     that app alone. <strong>Shared</strong> ones come from Claude Code settings or a project file,\n     so every app sees them and there is nothing to copy. Keys stay hidden until you ask.</div>`;\n  $(\'mcpbody\').querySelectorAll(\'.tab\').forEach(t=>t.onclick=()=>{mcpTab=t.dataset.t;drawMcp()});\n  $(\'mcpbody\').querySelectorAll(\'[data-act="copy"]\').forEach(b=>b.onclick=e=>{\n    copyMcpFlow(e.currentTarget.closest(\'tr\').dataset.id)});\n  $(\'mcpbody\').querySelectorAll(\'[data-act="key"]\').forEach(b=>b.onclick=e=>{\n    revealKeys(e.currentTarget.closest(\'tr\').dataset.id)});\n}\nasync function revealKeys(id){\n  const m=mcp.servers.find(x=>x.id===id);\n  const box=$(\'mcpbody\').querySelector(`.keys[data-for="${CSS.escape(id)}"]`);\n  const btn=$(\'mcpbody\').querySelector(`tr[data-id="${CSS.escape(id)}"] [data-act="key"]`);\n  const setIcon=on=>{if(btn){btn.innerHTML=on?EYEOFF:EYE;\n    btn.title=on?\'Hide the stored value\':\'Show the stored value\'}};\n  if(box.dataset.open){box.innerHTML=\'\';delete box.dataset.open;setIcon(false);return}\n  box.dataset.open=\'1\';setIcon(true);box.innerHTML=\'<div class="keyrow">reading…</div>\';\n  const parts=[];\n  for(const k of m.secrets){\n    const r=await api(`/api/mcp_reveal?id=${encodeURIComponent(id)}&key=${encodeURIComponent(k)}`);\n    parts.push(r.ok\n      ? `<div class="keyrow"><span>${esc(k)}</span><span class="keyval">${esc(r.value)}</span>\n         <span>${esc(r.note)}</span></div>`\n      : `<div class="keyrow">${esc(k)}: ${esc(r.msg)}</div>`);\n  }\n  box.innerHTML=parts.join(\'\')+\n    \'<div class="keyrow" style="color:var(--warn)">on screen now, careful sharing this window</div>\';\n}\nlet cpId=null;\nasync function copyMcpFlow(id){\n  cpId=id;\n  const m=mcp.servers.find(x=>x.id===id);\n  const others=mcp.instances.filter(i=>i!==m.scope);\n  $(\'cpTitle\').textContent=\'Copy \'+m.name;\n  $(\'cpFrom\').textContent=`currently set up in ${m.scope} · ${m.kind}`;\n  $(\'cpDest\').innerHTML=others.map(o=>`<option>${esc(o)}</option>`).join(\'\')\n    || \'<option disabled>no other Claude app on this Mac</option>\';\n  document.querySelectorAll(\'#ovcopy .tab\').forEach(t=>t.classList.toggle(\'on\',t.dataset.c===\'here\'));\n  $(\'cpHere\').hidden=false;$(\'cpAway\').hidden=true;$(\'cpGo\').hidden=false;\n  $(\'ovcopy\').classList.add(\'on\');\n  planCopy();\n}\nasync function planCopy(){\n  const to=$(\'cpDest\').value;\n  if(!to){$(\'cpPlan\').innerHTML=\'<div class="warn">There is only one Claude app on this Mac.</div>\';\n    $(\'cpGo\').disabled=true;return}\n  $(\'cpPlan\').innerHTML=\'<div class="empty">checking…</div>\';\n  const p=await api(\'/api/mcp_copy\',{method:\'POST\',headers:{\'content-type\':\'application/json\'},\n    body:JSON.stringify({id:cpId,to,dry:true})});\n  if(!p.ok){$(\'cpPlan\').innerHTML=`<div class="warn">${esc(p.msg)}</div>`;$(\'cpGo\').disabled=true;return}\n  $(\'cpPlan\').innerHTML=\n    `<div class="mgroup">what gets written</div>`+\n    `<div class="plan"